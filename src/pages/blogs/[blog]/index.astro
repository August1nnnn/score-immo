---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { blog: 'guides' } },
    { params: { blog: 'villes' } },
    { params: { blog: 'quartiers' } },
    { params: { blog: 'pro' } },
  ];
}

const { blog } = Astro.params;
const articles = (await getCollection('articles', (e) => e.data.blog === blog))
  .sort((a, b) => new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime());

const titles: Record<string, string> = {
  guides: "Le Guide de l'Acheteur - Conseils immobiliers",
  villes: "Prix immobilier par ville 2026 : carte, m² et tendances",
  quartiers: "Meilleurs Quartiers pour Acheter - Guide 2026",
  pro: "Se lancer dans l'immobilier - Guide du mandataire 2026",
};
const descriptions: Record<string, string> = {
  guides: "Nos guides pratiques pour acheter en confiance : DPE, négociation, frais de notaire, prêt, SCI, premier achat. Conseils concrets et chiffrés.",
  villes: "Comparez l'évolution des prix immobiliers par ville en 2026 : prix au m², cartes, tendances et analyses DVF pour Paris, Lyon, Bordeaux et plus.",
  quartiers: "Les meilleurs quartiers pour acheter : analyses détaillées par ville. Où investir, où habiter, qualité de vie et prix.",
  pro: "Devenir mandataire immobilier, choisir son réseau (IAD, SAFTI, Capifrance, Efficity), estimer, prospecter et décrocher des mandats. Le guide des pros de l'immobilier.",
};

const title = `${titles[blog!]} | ScoreImmo`;
const description = descriptions[blog!];

const labels: Record<string, string> = {
  guides: "Guide de l'acheteur",
  villes: 'Prix par ville',
  quartiers: 'Meilleurs quartiers',
  pro: 'Espace mandataires',
};
const headings: Record<string, string> = {
  ...labels,
  villes: "Prix immobilier par ville en 2026",
};

const canonical = `https://score-immo.fr/blogs/${blog}`;

const jsonLd: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": titles[blog!],
    "description": descriptions[blog!],
    "url": canonical,
    "isPartOf": { "@id": "https://score-immo.fr/#website" },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": articles.length,
      "itemListElement": articles.map((a, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://score-immo.fr/blogs/${a.data.blog}/${a.data.handle}`,
        "name": a.data.title,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://score-immo.fr/" },
      { "@type": "ListItem", "position": 2, "name": labels[blog!], "item": canonical },
    ],
  },
];

if (blog === 'villes') {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "Dataset",
    "name": "Prix immobilier par ville 2026 - ScoreImmo",
    "description": "Analyses chiffrées du marché immobilier français par ville. Prix au m², évolution, tendances par arrondissement/quartier. Données sourcées DVF, INSEE, notaires de France.",
    "url": canonical,
    "license": "https://creativecommons.org/licenses/by/4.0/",
    "creator": {
      "@type": "Organization",
      "name": "ScoreImmo",
      "url": "https://score-immo.fr",
    },
    "keywords": ["prix immobilier France", "prix m² par ville", "marché immobilier résidentiel", "DVF", "évolution prix immobilier 2026"],
    "spatialCoverage": { "@type": "Place", "name": "France" },
    "temporalCoverage": "2025-01-01/2026-12-31",
    "isBasedOn": [
      "https://www.data.gouv.fr/fr/datasets/demandes-de-valeurs-foncieres-geolocalisees/",
      "https://www.insee.fr/fr/statistiques/serie/001515333",
    ],
  });
}
---
<BaseLayout {title} {description} {canonical} {jsonLd}>
  <section class="si-section">
    <div class="si-container">
      <div class="si-blog-header">
        <h1 class="si-section-title">{headings[blog!]}</h1>
        <p class="si-section-subtitle">{descriptions[blog!]}</p>
        {blog === 'villes' && (
          <p class="si-collection-summary">
            <strong>En bref :</strong> {articles.length} analyses sourcées pour comparer les prix au m² et l'évolution du marché immobilier dans les villes françaises.
          </p>
        )}
        {blog === 'pro' && (
          <p style="margin-top:1rem;"><a href="/pro" style="display:inline-flex;align-items:center;gap:0.4rem;font-weight:600;color:var(--si-accent,#3B82F6);text-decoration:none;">Découvrir ScoreImmo Pro pour les mandataires &rarr;</a></p>
        )}
      </div>

      <div class="si-grid-3">
        {articles.map((a) => (
          <a href={`/blogs/${a.data.blog}/${a.data.handle}`} class="si-blog-card">
            {a.data.image?.src && (
              <img
                src={a.data.image.src}
                alt={a.data.image.alt || a.data.title}
                loading="lazy"
                width="600"
                height="400"
              />
            )}
            <div class="si-blog-card-body">
              <h3 class="si-blog-card-title">{a.data.title}</h3>
              <p class="si-blog-card-excerpt">{a.data.meta_description?.slice(0, 150)}</p>
            </div>
          </a>
        ))}
      </div>

      {blog === 'villes' && (
        <div class="si-city-guide">
          <section aria-labelledby="comparer-prix-ville">
            <h2 id="comparer-prix-ville">Comment comparer les prix immobiliers par ville ?</h2>
            <p>
              Un prix au m² n'est comparable que si le type de bien, la période des ventes et le secteur sont cohérents. Nos analyses mettent les transactions DVF en contexte avec le quartier, le marché local et les caractéristiques du logement.
            </p>
            <p>
              Commencez par la ville, puis vérifiez les écarts entre quartiers et la date des données avant d'estimer une annonce précise.
            </p>
          </section>

          <section aria-labelledby="marches-paris-bordeaux">
            <h2 id="marches-paris-bordeaux">Explorer les marchés de Paris et Bordeaux</h2>
            <div class="si-city-priority-links">
              <a href="/blogs/villes/prix-immobilier-paris-marche-plancher">
                <strong>Prix immobilier à Paris</strong>
                <span>Comparer les prix au m² par arrondissement et leur évolution.</span>
              </a>
              <a href="/blogs/villes/prix-immobilier-bordeaux-quartiers-tendances">
                <strong>Prix immobilier à Bordeaux</strong>
                <span>Lire le marché quartier par quartier avant de faire une offre.</span>
              </a>
            </div>
          </section>

          <section aria-labelledby="prix-vers-decision">
            <h2 id="prix-vers-decision">Du prix au m² à la décision d'achat</h2>
            <p>
              Le prix local est un point de départ. Vérifiez aussi la <a href="/blogs/guides/dpe-comprendre-classes-energetiques">grille DPE 2026</a>, l'état du bien et les ventes comparables. Consultez ensuite les <a href="/blogs/guides/marge-negociation-immobilier-2026">repères de marge de négociation immobilière</a>, puis préparez votre offre avec notre <a href="/blogs/guides/negocier-prix-bien-immobilier-guide-complet">méthode pour négocier le prix d'un bien</a>.
            </p>
          </section>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .si-blog-header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3rem;
  }
  .si-collection-summary {
    margin: 1rem auto 0;
    max-width: 38rem;
    color: var(--si-foreground);
    line-height: 1.65;
  }
  .si-city-guide {
    display: grid;
    gap: 2rem;
    max-width: 56rem;
    margin: 4rem auto 0;
  }
  .si-city-guide section {
    padding: 2rem;
    border: 1px solid var(--si-border, #E2E8F0);
    border-radius: 1rem;
    background: var(--si-surface, #FFFFFF);
  }
  .si-city-guide h2 {
    margin: 0 0 1rem;
    color: var(--si-foreground);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
  }
  .si-city-guide p {
    margin: 0;
    color: var(--si-muted-foreground, #475569);
    line-height: 1.7;
  }
  .si-city-guide p + p {
    margin-top: 0.75rem;
  }
  .si-city-guide p a {
    color: var(--si-accent, #2563EB);
    font-weight: 600;
  }
  .si-city-priority-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .si-city-priority-links a {
    display: grid;
    gap: 0.4rem;
    padding: 1rem;
    border-radius: 0.75rem;
    background: var(--si-background, #F8FAFC);
    color: var(--si-foreground);
    text-decoration: none;
  }
  .si-city-priority-links a:hover {
    color: var(--si-accent, #2563EB);
  }
  .si-city-priority-links span {
    color: var(--si-muted-foreground, #475569);
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .si-city-guide section {
      padding: 1.5rem;
    }
    .si-city-priority-links {
      grid-template-columns: 1fr;
    }
  }
</style>
