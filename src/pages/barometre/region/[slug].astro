---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TLDRBox from '@/components/TLDRBox.astro';
import FAQ from '@/components/FAQ.astro';
import SourcesSection from '@/components/SourcesSection.astro';
import AnalyzerBox from '@/components/AnalyzerBox.astro';
import { getCollection } from 'astro:content';
import { slugifyRegion as slugify, groupByRegion, REGION_MIN } from '@/lib/regions';
import { aggregateEdition, scoreSectionCountRange, selectLatestRegionalEdition } from '@/lib/barometre-editions';
import { BRAND_NAME, ORGANIZATION_ID, SITE_URL, WEBSITE_ID } from '@/data/entity';

export async function getStaticPaths() {
  const all = (await getCollection('barometre')).map((e) => e.data);
  const g = groupByRegion(all);
  return [...g.entries()].flatMap(([region, fiches]) => {
    try {
      selectLatestRegionalEdition(fiches, { minCount: REGION_MIN });
      return [{ params: { slug: slugify(region) }, props: { region } }];
    } catch {
      return [];
    }
  });
}

const { region } = Astro.props;
const all = (await getCollection('barometre')).map((e) => e.data);
const regionalFiches = groupByRegion(all).get(region)!;
const edition = selectLatestRegionalEdition(regionalFiches, { minCount: REGION_MIN });
const fiches = edition.fiches;
const editionStats = aggregateEdition(fiches);
const canonical = `${SITE_URL}/barometre/region/${slugify(region)}`;

const typeLabel = (t: string) => (t === 'appartement' ? 'Appartement' : 'Maison');
const fr = (n: number | null) => (n == null ? null : n.toLocaleString('fr-FR'));
const n = fiches.length;
const avgScore = editionStats.avgScore;
const communes = new Set(fiches.map((f) => f.ville)).size;
const lastDate = editionStats.latestAnalysisDate;
const lastDateFmt = lastDate
  ? new Date(lastDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' })
  : null;
const editionLabel = new Date(`${edition.month}-01T12:00:00Z`).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' });
const sectionRange = scoreSectionCountRange(fiches);
const sectionCountLabel = sectionRange.minimum === sectionRange.maximum
  ? `${sectionRange.minimum}`
  : `${sectionRange.minimum} à ${sectionRange.maximum}`;
const sectionCountPhrase = `${sectionCountLabel} section${sectionRange.maximum > 1 ? 's' : ''}`;

const title = `Annonces immobilières analysées en ${region} | Baromètre ${BRAND_NAME}`;
const description = `Édition ${editionLabel} : ${n} annonces analysées par ${BRAND_NAME} en ${region}, dans ${communes} communes. Score moyen de l'échantillon : ${avgScore}/100.`.slice(0, 160);

const tldr = [
  `Édition ${editionLabel} : ${n} annonces analysées dans ${communes} communes de ${region}.`,
  `Score ${BRAND_NAME} moyen de cette édition homogène : ${avgScore}/100.`,
  `Chaque fiche de cette édition affiche ${sectionCountPhrase} réellement notées et sa propre date d'analyse.`,
].filter(Boolean) as string[];

const faq = [
  {
    q: `Quel est le score immobilier moyen en ${region} ?`,
    a: `Dans l'édition ${editionLabel}, les ${n} annonces de l'échantillon publié en ${region} obtiennent un score moyen de ${avgScore}/100. La meilleure note du panel est ${fiches[0].score_global}/100 à ${fiches[0].ville}.`,
  },
  {
    q: `Combien de biens Score-Immo publie-t-il dans cet échantillon en ${region} ?`,
    a: `${BRAND_NAME} retient ${n} instantanés datés dans l'édition régionale ${editionLabel}, répartis dans ${communes} communes. Chaque fiche indique les sections et sources disponibles lors de l'analyse.${lastDateFmt ? ` Dernière analyse de cette édition : ${lastDateFmt}.` : ''}`,
  },
  {
    q: `Comment lire les scores de cet échantillon ?`,
    a: `Chaque fiche est un instantané daté utilisant la même méthode, avec ${sectionCountPhrase} réellement notées selon les données disponibles. Les agrégats de cette page ne mélangent jamais deux mois ou deux méthodes de notation.`,
  },
].filter(Boolean) as { q: string; a: string }[];

const sources = [
  { title: 'Demandes de valeurs foncières (DVF)', url: 'https://app.dvf.etalab.gouv.fr/', publisher: 'data.gouv.fr' },
  { title: 'Diagnostic de performance énergétique', url: 'https://data.ademe.fr/', publisher: 'ADEME' },
  { title: 'Risques naturels et technologiques', url: 'https://www.georisques.gouv.fr/', publisher: 'Géorisques' },
  { title: 'Revenus et démographie communale', url: 'https://www.insee.fr/', publisher: 'INSEE' },
];

const scoreColor = (s: number) => (s >= 70 ? '#16A34A' : s >= 40 ? '#B45309' : '#DC2626');

const jsonLd: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonical,
    inLanguage: 'fr-FR',
    ...(lastDate ? { dateModified: lastDate } : {}),
    isPartOf: { '@id': WEBSITE_ID },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.si-article-title', '.si-tldr'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `Annonces analysées par ${BRAND_NAME} en ${region}, édition ${editionLabel}`,
    description: `Échantillon de ${n} instantanés datés dans ${communes} communes de ${region}. Score moyen de l'édition ${editionLabel} : ${avgScore}/100.`,
    url: canonical,
    isAccessibleForFree: true,
    creator: { '@id': ORGANIZATION_ID },
    ...(lastDate ? { dateModified: lastDate } : {}),
    temporalCoverage: edition.month,
    spatialCoverage: { '@type': 'Place', name: region, address: { '@type': 'PostalAddress', addressRegion: region, addressCountry: 'FR' } },
    measurementTechnique: `Instantanés datés produits avec une même méthode ; chaque fiche publie ${sectionCountPhrase}, sans mélange avec les autres éditions.`,
    variableMeasured: [
      { '@type': 'PropertyValue', name: 'Biens analysés', value: n },
      { '@type': 'PropertyValue', name: 'Score moyen de l’échantillon (0-100)', value: avgScore },
      { '@type': 'PropertyValue', name: 'Communes représentées', value: communes },
      { '@type': 'PropertyValue', name: 'Sections visibles par fiche', value: sectionCountLabel },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Baromètre', item: `${SITE_URL}/barometre` },
      { '@type': 'ListItem', position: 3, name: region, item: canonical },
    ],
  },
];
---
<BaseLayout {title} {description} {canonical} {jsonLd}>
  <section class="si-section">
    <div class="si-container">
      <nav class="si-breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span> &rsaquo; </span>
        <a href="/barometre">Le Baromètre</a><span> &rsaquo; </span>
        <span>{region}</span>
      </nav>

      <header class="reg-header">
        <p class="reg-edition">Édition {editionLabel}</p>
        <h1 class="si-article-title">Annonces immobilières analysées en {region}</h1>
        <p class="reg-lead">Un échantillon homogène de {n} annonces dans {communes} communes de {region}, publié sous
        forme d'instantanés datés avec uniquement les sections réellement notées lors de chaque analyse.</p>
        <div class="reg-stats">
          <div><strong>{n}</strong><span>biens analysés</span></div>
          <div><strong>{avgScore}/100</strong><span>score moyen</span></div>
          <div><strong>{communes}</strong><span>communes représentées</span></div>
        </div>
      </header>

      <div class="reg-narrow">
        <TLDRBox items={tldr} />
      </div>

      <h2 class="reg-h2">Les biens analysés en {region}</h2>
      <div class="reg-grid">
        {fiches.map((f) => (
          <a class="bar-card" href={`/barometre/${f.slug}`}>
            <span class="bar-card-score" style={`color:${scoreColor(f.score_global)}`}>{f.score_global}<small>/100</small></span>
            <span class="bar-card-city">{f.ville}</span>
            <span class="bar-card-meta">{typeLabel(f.type_bien)} · {f.surface} m²{f.prix_m2 ? ` · ${fr(f.prix_m2)} €/m²` : ''}</span>
          </a>
        ))}
      </div>

      <div class="reg-narrow">
        <FAQ items={faq} />
        <AnalyzerBox blog="villes" medium="barometre_region" />
        <SourcesSection sources={sources} />
        <p class="reg-method">Méthodologie : les agrégats décrivent uniquement cette édition de {n} fiches et cette
        méthode, avec {sectionCountPhrase} par fiche. Ils ne constituent pas un baromètre de prix de toute la région. Les instantanés
        ne sont pas recalculés lorsque le moteur évolue. <a href="/methodologie">Lire la méthode et ses limites.</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .si-breadcrumb { font-size: 0.875rem; color: var(--si-muted-foreground, #64748B); margin: 1rem 0 2rem; }
  .si-breadcrumb a { color: var(--si-muted-foreground, #64748B); text-decoration: none; }
  .si-breadcrumb a:hover { color: var(--si-accent, #3B82F6); }
  .reg-header { max-width: 48rem; margin: 0 auto 1rem; text-align: center; }
  .reg-edition { margin: 0 0 0.5rem; color: var(--si-accent, #2563EB); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.8rem; }
  .si-article-title { font-family: var(--si-font-heading, 'DM Sans', sans-serif); font-size: clamp(1.9rem, 5vw, 2.8rem); font-weight: 700; line-height: 1.12; letter-spacing: -0.025em; margin: 0 0 1rem; color: var(--si-foreground); }
  .reg-lead { font-size: 1.1rem; line-height: 1.7; color: var(--si-muted-foreground, #64748B); margin: 0 auto 1.5rem; }
  .reg-narrow { max-width: 48rem; margin: 0 auto; }
  .reg-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2rem; margin: 1.5rem 0; }
  .reg-stats div { display: flex; flex-direction: column; }
  .reg-stats strong { font-family: var(--si-font-heading); font-size: 1.75rem; font-weight: 800; color: var(--si-accent, #3B82F6); }
  .reg-stats span { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--si-muted-foreground); }
  .reg-h2 { font-family: var(--si-font-heading); font-size: 1.5rem; font-weight: 700; margin: 2.5rem 0 1rem; color: var(--si-foreground); }
  .reg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .bar-card { display: flex; flex-direction: column; gap: 0.25rem; padding: 1.1rem 1.25rem; border: 1px solid var(--si-border, #E2E8F0); border-radius: var(--si-radius, 0.75rem); background: var(--si-card, #fff); text-decoration: none; transition: box-shadow 0.2s, transform 0.2s; }
  .bar-card:hover { box-shadow: var(--si-shadow-lg, 0 10px 15px -3px rgba(0,0,0,0.1)); transform: translateY(-2px); }
  .bar-card-score { font-family: var(--si-font-heading); font-size: 1.9rem; font-weight: 800; line-height: 1; }
  .bar-card-score small { font-size: 0.8rem; color: var(--si-muted-foreground); font-weight: 600; }
  .bar-card-city { font-weight: 700; font-size: 1.05rem; color: var(--si-foreground); }
  .bar-card-meta { font-size: 0.85rem; color: var(--si-foreground); }
  .reg-method { font-size: 0.875rem; color: var(--si-muted-foreground); line-height: 1.6; margin-top: 1.5rem; }
</style>
