---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TLDRBox from '@/components/TLDRBox.astro';
import AnalyzerBox from '@/components/AnalyzerBox.astro';
import FAQ from '@/components/FAQ.astro';
import { getCollection } from 'astro:content';
import { slugifyRegion, groupByRegion, REGION_MIN } from '@/lib/regions';
import { aggregateEdition, groupByEdition, scoreSectionCountRange, selectLatestEdition } from '@/lib/barometre-editions';
import { BRAND_NAME, ORGANIZATION_ID, SITE_URL, WEBSITE_ID } from '@/data/entity';

const canonical = `${SITE_URL}/barometre`;

const all = (await getCollection('barometre')).map((e) => e.data);
const editions = groupByEdition(all);
const latestEdition = selectLatestEdition(all);
const current = latestEdition.fiches;
const archiveEditions = editions.slice(1);
const stats = aggregateEdition(current);
const total = current.length;
const archiveTotal = all.length - total;
const avg = stats.avgScore;
const regions = stats.regions;
const best = current.slice(0, 3);
const sectionRange = scoreSectionCountRange(current);
const sectionCountLabel = sectionRange.minimum === sectionRange.maximum
  ? `${sectionRange.minimum}`
  : `${sectionRange.minimum} à ${sectionRange.maximum}`;
const sectionCountPhrase = `${sectionCountLabel} section${sectionRange.maximum > 1 ? 's' : ''}`;
const editionLabel = new Date(`${latestEdition.month}-01T12:00:00Z`).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' });

const title = `Baromètre immobilier : ${total} annonces, ${editionLabel} | ${BRAND_NAME}`;
const description = `Édition ${editionLabel} : ${total} annonces analysées par ${BRAND_NAME} dans ${regions} régions. Scores datés sur 100, DPE et points de vigilance.`.slice(0, 160);

const tldr = [
  `Édition ${editionLabel} : ${total} annonces analysées et notées sur 100 dans ${regions} régions.`,
  `Score moyen de cette édition homogène : ${avg}/100.`,
  `Chaque fiche affiche ${sectionCountPhrase} réellement notées selon les données disponibles lors de l'analyse.`,
  `${archiveTotal} fiche(s) antérieure(s) restent accessibles dans les archives, sans être mélangées aux chiffres de ${editionLabel}.`,
];

const scoreColor = (s: number) => (s >= 70 ? '#16A34A' : s >= 40 ? '#B45309' : '#DC2626');
const typeLabel = (t: string) => (t === 'appartement' ? 'Appartement' : 'Maison');

// Region aggregates -> links to the regional pages (real aggregates, >=3 fiches).
const regionLinks = [...groupByRegion(current).entries()]
  .filter(([, fs]) => fs.length >= REGION_MIN)
  .map(([region, fs]) => ({
    region, slug: slugifyRegion(region), count: fs.length,
    avg: Math.round(fs.reduce((s, f) => s + f.score_global, 0) / fs.length),
  }))
  .sort((a, b) => b.count - a.count);

const lastDate = stats.latestAnalysisDate;
const lastDateFmt = lastDate ? new Date(lastDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' }) : null;

const faq: { q: string; a: string }[] = [
  {
    q: `Quel est le score moyen de l'échantillon publié par Score-Immo ?`,
    a: `Dans l'édition ${editionLabel}, les ${total} annonces publiées dans ${regions} régions obtiennent un score moyen de ${avg}/100. La meilleure note de l'échantillon est ${best[0]?.score_global}/100 (${best[0]?.ville}). Ce chiffre ne représente pas l'ensemble du marché français.`,
  },
  {
    q: `Combien d'annonces immobilières Score-Immo publie-t-il dans ce Baromètre ?`,
    a: `L'édition ${editionLabel} publie ${total} analyses datées, réparties sur ${regions} régions françaises. Les ${archiveTotal} fiches antérieures sont conservées séparément et ne sont pas incluses dans les agrégats de cette édition.`,
  },
  {
    q: `Pourquoi certaines fiches affichent-elles cinq sections et d'autres jusqu'à treize ?`,
    a: `Les fiches de juin 2026 conservent la grille historique exacte de cinq sections utilisée lors de leur publication. Les fiches courantes affichent uniquement les sections réellement notées, au moins cinq parmi les treize axes connus. Les notes absentes ne sont ni remplacées par zéro ni recalculées silencieusement.`,
  },
  {
    q: `Quelles sont les limites des notes du Baromètre ?`,
    a: `Les notes sont des instantanés indicatifs fondés sur les données disponibles lors de l'analyse. Elles ne constituent ni une expertise immobilière ni un conseil en investissement.${lastDateFmt ? ` Dernière analyse publiée : ${lastDateFmt}.` : ''}`,
  },
];

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Baromètre ${BRAND_NAME}, édition ${editionLabel} : ${total} analyses d'annonces`,
  description: `Échantillon de ${total} annonces immobilières analysées dans ${regions} régions françaises en ${editionLabel}. Score moyen de l'édition : ${avg}/100.`,
  url: canonical,
  isAccessibleForFree: true,
  creator: { '@id': ORGANIZATION_ID },
  ...(lastDate ? { dateModified: lastDate } : {}),
  spatialCoverage: { '@type': 'Place', name: 'France' },
  temporalCoverage: latestEdition.month,
  measurementTechnique: `Instantanés datés produits avec la méthode résidentielle courante ; chaque fiche publie ${sectionCountPhrase} selon les données disponibles lors de son analyse.`,
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'Annonces analysées', value: total },
    { '@type': 'PropertyValue', name: 'Score moyen de l’échantillon (0-100)', value: avg },
    { '@type': 'PropertyValue', name: 'Régions couvertes', value: regions },
    { '@type': 'PropertyValue', name: 'Sections visibles par fiche', value: sectionCountLabel },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const jsonLd: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonical,
    inLanguage: 'fr-FR',
    isPartOf: { '@id': WEBSITE_ID },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.si-article-title', '.si-tldr'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: current.map((f, i) => ({
      '@type': 'ListItem', position: i + 1, name: `${f.ville} · ${typeLabel(f.type_bien)} ${f.surface} m² (${f.score_global}/100)`,
      url: `${SITE_URL}/barometre/${f.slug}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Baromètre', item: canonical },
    ],
  },
  datasetSchema,
  faqSchema,
];
---
<BaseLayout {title} {description} {canonical} {jsonLd}>
  <section class="si-section">
    <div class="si-container">
      <nav class="si-breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span> &rsaquo; </span><span>Le Baromètre immobilier</span>
      </nav>

      <header class="bar-hub-header">
        <p class="bar-edition">Édition {editionLabel}</p>
        <h1 class="si-article-title">Le Baromètre immobilier Score-Immo</h1>
        <p class="bar-hub-lead">Un observatoire de fiches issues d'annonces réellement analysées, publié édition par édition.
        Chaque instantané affiche son score, ses sections réellement notées, sa date d'analyse et ses limites.</p>
        <div class="bar-stats">
          <div><strong>{total}</strong><span>annonces notées</span></div>
          <div><strong>{avg}/100</strong><span>score moyen</span></div>
          <div><strong>{regions}</strong><span>régions</span></div>
          <div><strong>{sectionCountLabel}</strong><span>sections par fiche</span></div>
        </div>
      </header>

      <div class="bar-hub-narrow">
        <TLDRBox items={tldr} />
      </div>

      <h2 class="bar-h2">Les meilleures notes de l'édition</h2>
      <div class="bar-grid">
        {best.map((f) => (
          <a class="bar-card bar-card-top" href={`/barometre/${f.slug}`}>
            <span class="bar-card-score" style={`color:${scoreColor(f.score_global)}`}>{f.score_global}<small>/100</small></span>
            <span class="bar-card-city">{f.ville}</span>
            <span class="bar-card-meta">{typeLabel(f.type_bien)} · {f.surface} m² · {f.region}</span>
          </a>
        ))}
      </div>

      {regionLinks.length > 0 && (
        <>
          <h2 class="bar-h2">Échantillons régionaux de l'édition</h2>
          <div class="bar-grid">
            {regionLinks.map((r) => (
              <a class="bar-card" href={`/barometre/region/${r.slug}`}>
                <span class="bar-card-city">{r.region}</span>
                <span class="bar-card-meta">{r.count} biens analysés · score moyen {r.avg}/100</span>
              </a>
            ))}
          </div>
        </>
      )}

      <h2 class="bar-h2">Toutes les analyses de {editionLabel}</h2>
      <div class="bar-grid">
        {current.map((f) => (
          <a class="bar-card" href={`/barometre/${f.slug}`}>
            <span class="bar-card-score" style={`color:${scoreColor(f.score_global)}`}>{f.score_global}<small>/100</small></span>
            <span class="bar-card-city">{f.ville}{f.is_edito ? ' ★' : ''}</span>
            <span class="bar-card-meta">{typeLabel(f.type_bien)} · {f.surface} m² · {f.prix_demande.toLocaleString('fr-FR')} €</span>
            <span class="bar-card-region">{f.region}{f.dpe ? ` · DPE ${f.dpe}` : ''}</span>
          </a>
        ))}
      </div>

      {archiveEditions.length > 0 && (
        <section class="bar-archives" aria-labelledby="bar-archives-title">
          <h2 class="bar-h2" id="bar-archives-title">Archives par méthode</h2>
          <p>Les éditions antérieures restent consultables dans leur état d'origine. Leurs scores ne sont pas mélangés avec ceux de {editionLabel}.</p>
          {archiveEditions.map((edition) => {
            const label = new Date(`${edition.month}-01T12:00:00Z`).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' });
            const archivedRange = scoreSectionCountRange(edition.fiches);
            const archivedSections = archivedRange.minimum === archivedRange.maximum
              ? `${archivedRange.minimum}`
              : `${archivedRange.minimum} à ${archivedRange.maximum}`;
            return (
              <details>
                <summary>{label} : {edition.fiches.length} fiches, {archivedSections} sections visibles par fiche</summary>
                <div class="bar-grid bar-archive-grid">
                  {edition.fiches.map((f) => (
                    <a class="bar-card" href={`/barometre/${f.slug}`}>
                      <span class="bar-card-score" style={`color:${scoreColor(f.score_global)}`}>{f.score_global}<small>/100</small></span>
                      <span class="bar-card-city">{f.ville}</span>
                      <span class="bar-card-meta">{typeLabel(f.type_bien)} · {f.surface} m² · {f.prix_demande.toLocaleString('fr-FR')} €</span>
                    </a>
                  ))}
                </div>
              </details>
            );
          })}
        </section>
      )}

      <div class="bar-hub-narrow">
        <FAQ items={faq} />
        <AnalyzerBox blog="villes" medium="barometre_hub" />
        <p class="bar-method">Méthodologie : le Baromètre contient des instantanés datés, pas une estimation du marché
        immobilier français. Les agrégats décrivent une seule édition et une seule méthode. Les fiches archivées ne sont
        pas recalculées automatiquement lorsque le moteur évolue. <a href="/methodologie">Lire la méthode et ses limites.</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .si-breadcrumb { font-size: 0.875rem; color: var(--si-muted-foreground, #64748B); margin: 1rem 0 2rem; }
  .si-breadcrumb a { color: var(--si-muted-foreground, #64748B); text-decoration: none; }
  .si-breadcrumb a:hover { color: var(--si-accent, #3B82F6); }
  .bar-hub-header { max-width: 48rem; margin: 0 auto 1rem; text-align: center; }
  .bar-edition { margin: 0 0 0.5rem; color: var(--si-accent, #2563EB); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.8rem; }
  .si-article-title { font-family: var(--si-font-heading, 'DM Sans', sans-serif); font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.025em; margin: 0 0 1rem; color: var(--si-foreground); }
  .bar-hub-lead { font-size: 1.1rem; line-height: 1.7; color: var(--si-muted-foreground, #64748B); margin: 0 auto 1.5rem; }
  .bar-hub-narrow { max-width: 48rem; margin: 0 auto; }
  .bar-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2rem; margin: 1.5rem 0; }
  .bar-stats div { display: flex; flex-direction: column; }
  .bar-stats strong { font-family: var(--si-font-heading); font-size: 1.75rem; font-weight: 800; color: var(--si-accent, #3B82F6); }
  .bar-stats span { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--si-muted-foreground); }
  .bar-h2 { font-family: var(--si-font-heading); font-size: 1.5rem; font-weight: 700; margin: 2.5rem 0 1rem; color: var(--si-foreground); }
  .bar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .bar-card { display: flex; flex-direction: column; gap: 0.25rem; padding: 1.1rem 1.25rem; border: 1px solid var(--si-border, #E2E8F0); border-radius: var(--si-radius, 0.75rem); background: var(--si-card, #fff); text-decoration: none; transition: box-shadow 0.2s, transform 0.2s; }
  .bar-card:hover { box-shadow: var(--si-shadow-lg, 0 10px 15px -3px rgba(0,0,0,0.1)); transform: translateY(-2px); }
  .bar-card-top { border-color: rgba(59,130,246,0.35); }
  .bar-card-score { font-family: var(--si-font-heading); font-size: 1.9rem; font-weight: 800; line-height: 1; }
  .bar-card-score small { font-size: 0.8rem; color: var(--si-muted-foreground); font-weight: 600; }
  .bar-card-city { font-weight: 700; font-size: 1.05rem; color: var(--si-foreground); }
  .bar-card-meta { font-size: 0.85rem; color: var(--si-foreground); }
  .bar-card-region { font-size: 0.8rem; color: var(--si-muted-foreground); }
  .bar-method { font-size: 0.875rem; color: var(--si-muted-foreground); line-height: 1.6; margin-top: 1.5rem; }
  .bar-method a { color: var(--si-accent, #3B82F6); }
  .bar-archives > p { max-width: 48rem; color: var(--si-muted-foreground); line-height: 1.6; }
  .bar-archives details { border-top: 1px solid var(--si-border, #E2E8F0); padding: 1rem 0; }
  .bar-archives summary { cursor: pointer; color: var(--si-foreground); font-weight: 700; }
  .bar-archive-grid { margin-top: 1rem; }
</style>
