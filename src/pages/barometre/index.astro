  /* Interactions des cartes */
  .bar-listing-card > a { position: relative; overflow: hidden; }
  .bar-listing-card > a::before {
    position: absolute; inset: 0 0 auto; height: 3px; background: linear-gradient(90deg, #2563eb, #38bdf8);
    transform: scaleX(0); transform-origin: left; transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1); content: '';
  }
  .bar-listing-card > a:hover::before, .bar-listing-card > a:focus-visible::before { transform: scaleX(1); }
  .bar-listing-link span { display: inline-block; transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1); }
