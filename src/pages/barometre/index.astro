  /* ---- Mouvement ----------------------------------------------------------
     Par défaut tout est visible. L'état masqué n'est appliqué que si le script
     a pu poser .si-reveal-on sur <html>, c'est-à-dire si IntersectionObserver
     existe et que l'utilisateur n'a pas demandé moins d'animations. Sans JS,
     sans observateur ou en reduced-motion, la page reste entièrement lisible. */
  [data-reveal] { opacity: 1; transform: none; }

  .si-reveal-on [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.55s ease var(--d, 0ms), transform 0.55s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms);
  }
  .si-reveal-on [data-reveal].is-in { opacity: 1; transform: none; }

