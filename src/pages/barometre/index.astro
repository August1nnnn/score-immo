<script>
  const fold = (value: string) => value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLocaleLowerCase('fr');

  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const explorer = document.querySelector<HTMLElement>('[data-barometre-explorer]');
  if (explorer) {
    const form = explorer.querySelector<HTMLFormElement>('[data-barometre-filters]');
    const list = explorer.querySelector<HTMLElement>('[data-barometre-list]');
    const cards = [...explorer.querySelectorAll<HTMLElement>('[data-barometre-card]')];
    const count = explorer.querySelector<HTMLElement>('[data-barometre-count]');
    const empty = explorer.querySelector<HTMLElement>('[data-barometre-empty]');
    const search = explorer.querySelector<HTMLInputElement>('[data-filter-search]');
    const type = explorer.querySelector<HTMLSelectElement>('[data-filter-type]');
    const dpe = explorer.querySelector<HTMLSelectElement>('[data-filter-dpe]');
    const region = explorer.querySelector<HTMLSelectElement>('[data-filter-region]');
    const sort = explorer.querySelector<HTMLSelectElement>('[data-filter-sort]');
    const collator = new Intl.Collator('fr', { sensitivity: 'base' });

    const applyFilters = () => {
      const query = fold(search?.value || '');
      const visible = cards.filter((card) => {
        const matches = (
          (!query || fold(card.dataset.search || '').includes(query))
          && (!type?.value || card.dataset.type === type.value)
          && (!dpe?.value || card.dataset.dpe === dpe.value)
          && (!region?.value || card.dataset.region === region.value)
        );
        card.hidden = !matches;
        return matches;
      });

      const ordered = [...cards].sort((a, b) => {
        if (sort?.value === 'score-asc') return Number(a.dataset.score) - Number(b.dataset.score);
        if (sort?.value === 'city-asc') return collator.compare(a.dataset.city || '', b.dataset.city || '');
        return Number(b.dataset.score) - Number(a.dataset.score);
      });
      ordered.forEach((card) => list?.append(card));
      if (empty) empty.hidden = visible.length > 0;

      if (count && count.textContent !== String(visible.length)) {
        count.textContent = String(visible.length);
        const badge = count.closest('.bar-result-count');
        if (badge && motionOk) {
          badge.classList.remove('is-pulsing');
          void (badge as HTMLElement).offsetWidth;
          badge.classList.add('is-pulsing');
          window.setTimeout(() => badge.classList.remove('is-pulsing'), 260);
        }
      }
    };

    if (motionOk && list) {
      let settle = 0;
      form?.addEventListener('input', () => {
        list.classList.add('is-filtering');
        window.clearTimeout(settle);
        settle = window.setTimeout(() => list.classList.remove('is-filtering'), 180);
      });
    }

    if (form && 'IntersectionObserver' in window) {
      const sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      form.before(sentinel);
      new IntersectionObserver(
        ([entry]) => form.classList.toggle('is-stuck', !entry.isIntersecting),
        { rootMargin: '-77px 0px 0px 0px', threshold: 1 },
      ).observe(sentinel);
    }

    form?.addEventListener('input', applyFilters);
    form?.addEventListener('change', applyFilters);
    form?.addEventListener('submit', (event) => event.preventDefault());
    form?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
  }

  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-citation]');
  const citation = document.querySelector<HTMLElement>('[data-citation-text]');
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
  copyButton?.addEventListener('click', async () => {
    const text = citation?.textContent?.trim() || '';
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      if (copyStatus) copyStatus.textContent = 'Citation copiée.';
      const label = copyButton.textContent;
      copyButton.classList.add('is-done');
      copyButton.textContent = 'Citation copiée';
      window.setTimeout(() => {
        copyButton.classList.remove('is-done');
        copyButton.textContent = label;
      }, 1800);
    } catch (_error) {
      const selection = window.getSelection();
      const range = document.createRange();
      if (citation && selection) {
        range.selectNodeContents(citation);
        selection.removeAllRanges();
        selection.addRange(range);
      }
      if (copyStatus) copyStatus.textContent = 'Citation sélectionnée, utilise la commande Copier.';
    }
  });
</script>

