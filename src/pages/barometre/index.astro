---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TLDRBox from '@/components/TLDRBox.astro';
import AnalyzerBox from '@/components/AnalyzerBox.astro';
import FAQ from '@/components/FAQ.astro';
import { getCollection } from 'astro:content';
import { slugifyRegion, groupByRegion, REGION_MIN } from '@/lib/regions';
import { BRAND_NAME, ORGANIZATION_ID, SITE_URL, WEBSITE_ID } from '@/data/entity';

const canonical = `${SITE_URL}/barometre`;

const all = (await getCollection('barometre')).map((e) => e.data);
all.sort((a, b) => b.score_global - a.score_global);

const total = all.length;
const avg = total ? Math.round(all.reduce((s, f) => s + f.score_global, 0) / total) : 0;
const regions = [...new Set(all.map((f) => f.region))].length;
const best = all.slice(0, 3);
const worst = [...all].slice(-3).reverse();

const title = `Le Baromètre Immobilier ${BRAND_NAME} : ${total} annonces notées sur 100`;
const description = `Échantillon de ${total} annonces analysées par ${BRAND_NAME} dans ${regions} régions. Instantanés datés avec score, prix, DPE et points de vigilance.`.slice(0, 160);

const tldr = [
  `${total} annonces réelles analysées et notées sur 100 dans ${regions} régions.`,
  `Score moyen du panel : ${avg}/100.`,
  `Ces résultats décrivent uniquement l'échantillon de fiches publiées et datées.`,
  `Le meilleur du mois : ${best[0]?.ville} (${best[0]?.score_global}/100).`,
];

const scoreColor = (s: number) => (s >= 70 ? '#16A34A' : s >= 40 ? '#B45309' : '#DC2626');
const typeLabel = (t: string) => (t === 'appartement' ? 'Appartement' : 'Maison');

// Region aggregates -> links to the regional pages (real aggregates, >=3 fiches).
const regionLinks = [...groupByRegion(all).entries()]
  .filter(([, fs]) => fs.length >= REGION_MIN)
  .map(([region, fs]) => ({
    region, slug: slugifyRegion(region), count: fs.length,
    avg: Math.round(fs.reduce((s, f) => s + f.score_global, 0) / fs.length),
  }))
  .sort((a, b) => b.count - a.count);

// Aggregate first-party figures (real, computed from the published fiches) for the
// Dataset + FAQ. This turns the hub into a citable primary source for queries like
// "score immobilier moyen" / "combien d'annonces analysees".
const withM2 = all.filter((f) => f.prix_m2);
const avgM2 = withM2.length ? Math.round(withM2.reduce((s, f) => s + (f.prix_m2 as number), 0) / withM2.length) : null;
const lastDate = all.map((f) => f.date_analyse).filter(Boolean).sort().slice(-1)[0] || null;
const lastDateFmt = lastDate ? new Date(lastDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' }) : null;

const faq: { q: string; a: string }[] = [
  {
    q: `Quel est le score moyen de l'échantillon publié par Score-Immo ?`,
    a: `Sur les ${total} annonces de cet échantillon dans ${regions} régions, le score moyen est de ${avg}/100. La meilleure note du panel est ${best[0]?.score_global}/100 (${best[0]?.ville}). Ce chiffre ne représente pas l'ensemble du marché français.`,
  },
  {
    q: `Combien d'annonces immobilières Score-Immo publie-t-il dans ce Baromètre ?`,
    a: `Le Baromètre Score-Immo publie ${total} analyses datées${avgM2 ? `, avec un prix moyen observé de ${avgM2.toLocaleString('fr-FR')} €/m² dans cet échantillon` : ''}, réparties sur ${regions} régions françaises.`,
  },
  {
    q: `Comment lire une ancienne fiche du Baromètre ?`,
    a: `Chaque fiche est un instantané daté qui publie cinq sections visibles : prix face au marché, performance énergétique, risques, urbanisme et environnement. La méthode actuelle de l'application est documentée séparément et peut évoluer.`,
  },
  {
    q: `Quelles sont les limites des notes du Baromètre ?`,
    a: `Les notes sont des instantanés indicatifs fondés sur les données disponibles lors de l'analyse. Elles ne constituent ni une expertise immobilière ni un conseil en investissement.${lastDateFmt ? ` Dernière analyse publiée : ${lastDateFmt}.` : ''}`,
  },
];

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Baromètre Immobilier ${BRAND_NAME} : ${total} instantanés datés`,
  description: `Échantillon de ${total} annonces immobilières analysées dans ${regions} régions françaises. Score moyen de l'échantillon ${avg}/100${avgM2 ? `, prix moyen observé ${avgM2} €/m²` : ''}.`,
  url: canonical,
  isAccessibleForFree: true,
  creator: { '@id': ORGANIZATION_ID },
  ...(lastDate ? { dateModified: lastDate } : {}),
  spatialCoverage: { '@type': 'Place', name: 'France' },
  measurementTechnique: 'Instantanés datés produits avec la grille historique visible de cinq sections : prix face au marché, performance énergétique, risques naturels, urbanisme et environnement.',
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'Annonces analysées', value: total },
    { '@type': 'PropertyValue', name: 'Score moyen de l’échantillon (0-100)', value: avg },
    { '@type': 'PropertyValue', name: 'Régions couvertes', value: regions },
    ...(avgM2 ? [{ '@type': 'PropertyValue', name: 'Prix moyen observé (€/m²)', value: avgM2 }] : []),
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const jsonLd: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonical,
    inLanguage: 'fr-FR',
    isPartOf: { '@id': WEBSITE_ID },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.si-article-title', '.si-tldr'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: all.map((f, i) => ({
      '@type': 'ListItem', position: i + 1, name: `${f.ville} · ${typeLabel(f.type_bien)} ${f.surface} m² (${f.score_global}/100)`,
      url: `${SITE_URL}/barometre/${f.slug}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Baromètre', item: canonical },
    ],
  },
  datasetSchema,
  faqSchema,
];
---
<BaseLayout {title} {description} {canonical} {jsonLd}>
  <section class="si-section">
    <div class="si-container">
      <nav class="si-breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span> &rsaquo; </span><span>Le Baromètre</span>
      </nav>

      <header class="bar-hub-header">
        <h1 class="si-article-title">Le Baromètre Immobilier Score-Immo</h1>
        <p class="bar-hub-lead">Un échantillon de fiches publiées pour examiner des annonces réelles à une date donnée.
        Chaque instantané affiche son score, ses cinq sections, sa date d'analyse et les sources disponibles.</p>
        <div class="bar-stats">
          <div><strong>{total}</strong><span>annonces notées</span></div>
          <div><strong>{avg}/100</strong><span>score moyen</span></div>
          <div><strong>{regions}</strong><span>régions</span></div>
          <div><strong>5</strong><span>sections publiées</span></div>
        </div>
      </header>

      <div class="bar-hub-narrow">
        <TLDRBox items={tldr} />
      </div>

      <h2 class="bar-h2">Le top du moment</h2>
      <div class="bar-grid">
        {best.map((f) => (
          <a class="bar-card bar-card-top" href={`/barometre/${f.slug}`}>
            <span class="bar-card-score" style={`color:${scoreColor(f.score_global)}`}>{f.score_global}<small>/100</small></span>
            <span class="bar-card-city">{f.ville}</span>
            <span class="bar-card-meta">{typeLabel(f.type_bien)} · {f.surface} m² · {f.region}</span>
          </a>
        ))}
      </div>

      {regionLinks.length > 0 && (
        <>
          <h2 class="bar-h2">Prix et scores par région</h2>
          <div class="bar-grid">
            {regionLinks.map((r) => (
              <a class="bar-card" href={`/barometre/region/${r.slug}`}>
                <span class="bar-card-city">{r.region}</span>
                <span class="bar-card-meta">{r.count} biens analysés · score moyen {r.avg}/100</span>
              </a>
            ))}
          </div>
        </>
      )}

      <h2 class="bar-h2">Toutes les analyses</h2>
      <div class="bar-grid">
        {all.map((f) => (
          <a class="bar-card" href={`/barometre/${f.slug}`}>
            <span class="bar-card-score" style={`color:${scoreColor(f.score_global)}`}>{f.score_global}<small>/100</small></span>
            <span class="bar-card-city">{f.ville}{f.is_edito ? ' ★' : ''}</span>
            <span class="bar-card-meta">{typeLabel(f.type_bien)} · {f.surface} m² · {f.prix_demande.toLocaleString('fr-FR')} €</span>
            <span class="bar-card-region">{f.region}{f.dpe ? ` · DPE ${f.dpe}` : ''}</span>
          </a>
        ))}
      </div>

      <div class="bar-hub-narrow">
        <FAQ items={faq} />
        <AnalyzerBox blog="villes" medium="barometre_hub" />
        <p class="bar-method">Méthodologie : le Baromètre contient des instantanés datés, pas une estimation du marché
        immobilier français. Les agrégats décrivent uniquement cet échantillon. Les fiches ne sont pas recalculées
        automatiquement lorsque le moteur évolue. <a href="/methodologie">Lire la méthode et ses limites.</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .si-breadcrumb { font-size: 0.875rem; color: var(--si-muted-foreground, #64748B); margin: 1rem 0 2rem; }
  .si-breadcrumb a { color: var(--si-muted-foreground, #64748B); text-decoration: none; }
  .si-breadcrumb a:hover { color: var(--si-accent, #3B82F6); }
  .bar-hub-header { max-width: 48rem; margin: 0 auto 1rem; text-align: center; }
  .si-article-title { font-family: var(--si-font-heading, 'DM Sans', sans-serif); font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.025em; margin: 0 0 1rem; color: var(--si-foreground); }
  .bar-hub-lead { font-size: 1.1rem; line-height: 1.7; color: var(--si-muted-foreground, #64748B); margin: 0 auto 1.5rem; }
  .bar-hub-narrow { max-width: 48rem; margin: 0 auto; }
  .bar-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2rem; margin: 1.5rem 0; }
  .bar-stats div { display: flex; flex-direction: column; }
  .bar-stats strong { font-family: var(--si-font-heading); font-size: 1.75rem; font-weight: 800; color: var(--si-accent, #3B82F6); }
  .bar-stats span { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--si-muted-foreground); }
  .bar-h2 { font-family: var(--si-font-heading); font-size: 1.5rem; font-weight: 700; margin: 2.5rem 0 1rem; color: var(--si-foreground); }
  .bar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .bar-card { display: flex; flex-direction: column; gap: 0.25rem; padding: 1.1rem 1.25rem; border: 1px solid var(--si-border, #E2E8F0); border-radius: var(--si-radius, 0.75rem); background: var(--si-card, #fff); text-decoration: none; transition: box-shadow 0.2s, transform 0.2s; }
  .bar-card:hover { box-shadow: var(--si-shadow-lg, 0 10px 15px -3px rgba(0,0,0,0.1)); transform: translateY(-2px); }
  .bar-card-top { border-color: rgba(59,130,246,0.35); }
  .bar-card-score { font-family: var(--si-font-heading); font-size: 1.9rem; font-weight: 800; line-height: 1; }
  .bar-card-score small { font-size: 0.8rem; color: var(--si-muted-foreground); font-weight: 600; }
  .bar-card-city { font-weight: 700; font-size: 1.05rem; color: var(--si-foreground); }
  .bar-card-meta { font-size: 0.85rem; color: var(--si-foreground); }
  .bar-card-region { font-size: 0.8rem; color: var(--si-muted-foreground); }
  .bar-method { font-size: 0.875rem; color: var(--si-muted-foreground); line-height: 1.6; margin-top: 1.5rem; }
  .bar-method a { color: var(--si-accent, #3B82F6); }
</style>
