---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnalyzerBox from '@/components/AnalyzerBox.astro';
import FAQ from '@/components/FAQ.astro';
import { getCollection } from 'astro:content';
import { slugifyRegion, REGION_MIN } from '@/lib/regions';
import {
  aggregateEdition,
  groupByEdition,
  scoreSectionCountRange,
  selectLatestEdition,
} from '@/lib/barometre-editions';
import { buildEditionInsights } from '@/lib/barometre-insights';
import { buildFicheSignal, axisBarHeight } from '@/lib/barometre-signal.ts';
import { buildEditionExport } from '@/lib/barometre-edition-export.js';
import { BRAND_NAME, ORGANIZATION_ID, SITE_URL, WEBSITE_ID } from '@/data/entity';
import capitalesAout from '@/data/barometre-capitales-2026-08.json';
import dmSans800Url from '@fontsource/dm-sans/files/dm-sans-latin-800-normal.woff2?url';
import inter400Url from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

const canonical = `${SITE_URL}/barometre`;

const all = (await getCollection('barometre')).map((entry) => entry.data);
const editions = groupByEdition(all);
const latestEdition = selectLatestEdition(all);
const current = latestEdition.fiches;
const archiveEditions = editions.slice(1);
const stats = aggregateEdition(current);
const insights = buildEditionInsights(current);
const editionExport = buildEditionExport(current, SITE_URL);
const total = current.length;
const archiveTotal = all.length - total;
const avg = stats.avgScore;
const regions = stats.regions;
const sectionRange = scoreSectionCountRange(current);
const sectionCountLabel = sectionRange.minimum === sectionRange.maximum
  ? `${sectionRange.minimum}`
  : `${sectionRange.minimum} à ${sectionRange.maximum}`;
const sectionCountPhrase = `${sectionCountLabel} section${sectionRange.maximum > 1 ? 's' : ''}`;
const editionLabel = new Date(`${latestEdition.month}-01T12:00:00Z`).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
});

const title = `Baromètre immobilier : ${total} annonces, ${editionLabel} | ${BRAND_NAME}`;
const description = `Édition ${editionLabel} : ${total} annonces analysées par ${BRAND_NAME} dans ${regions} régions. Scores datés sur 100, DPE et points de vigilance.`.slice(0, 160);

const scoreColor = (s: number) => (s >= 70 ? '#16A34A' : s >= 40 ? '#B45309' : '#DC2626');
const typeLabel = (type: string) => (type === 'appartement' ? 'Appartement' : 'Maison');
const regionOptions = [...new Set(current.map((fiche) => fiche.region))].sort((a, b) => a.localeCompare(b, 'fr'));
const dpeOptions = [...new Set(current.map((fiche) => fiche.dpe).filter(Boolean))].sort();
const dpeCount = (labels: string[]) => insights.dpe
  .filter(({ label }) => labels.includes(label))
  .reduce((sum, { count }) => sum + count, 0);
const dpePeak = Math.max(...insights.dpe.map(({ count }) => count), 1);
const lastDate = stats.latestAnalysisDate;
const lastDateFmt = lastDate
  ? new Date(`${lastDate}T12:00:00Z`).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
const editionJsonUrl = `/barometre/editions/${latestEdition.month}.json`;
const editionCsvUrl = `/barometre/editions/${latestEdition.month}.csv`;
const citation = `${BRAND_NAME}, Le Baromètre immobilier des annonces analysées, édition ${editionLabel}, échantillon de ${total} annonces, version ${latestEdition.month}, ${SITE_URL}${editionJsonUrl}.`;
const capitalObservations = capitalesAout.observations;
const partialCapitalObservations = capitalesAout.observations_partielles;
const allCapitalObservations = [...capitalObservations, ...partialCapitalObservations]
  .sort((left, right) => left.region_code.localeCompare(right.region_code, 'fr'));
const unavailableCapitals = capitalesAout.indisponibles;
const capitalJsonUrl = '/barometre/capitales/2026-08.json';
const capitalCsvUrl = '/barometre/capitales/2026-08.csv';
const capitalMapPoints = capitalObservations
  .filter(({ region_code }) => !['01', '02'].includes(region_code))
  .map((observation) => ({
    ...observation,
    x: Math.max(5, Math.min(95, ((observation.longitude_capitale + 5.5) / 15) * 100)),
    y: Math.max(5, Math.min(95, ((51.2 - observation.latitude_capitale) / 10.2) * 100)),
  }));
const overseasCapitalObservations = allCapitalObservations
  .filter(({ region_code }) => ['01', '02', '03', '04'].includes(region_code));

const faq: { q: string; a: string }[] = [
  {
    q: `Quel est le score moyen de l'échantillon publié par Score-Immo ?`,
    a: `Dans l'édition ${editionLabel}, les ${total} annonces analysées dans ${regions} régions obtiennent un score moyen de ${avg}/100 et un score médian de ${insights.medianScore}/100. La plage observée va de ${insights.minimumScore} à ${insights.maximumScore}/100. Ces chiffres décrivent cet échantillon, pas l'ensemble du marché français.`,
  },
  {
    q: `Combien d'annonces immobilières Score-Immo publie-t-il dans ce Baromètre ?`,
    a: `L'édition ${editionLabel} publie ${total} analyses datées, réparties sur ${regions} régions françaises. Les ${archiveTotal} analyses antérieures sont conservées séparément et ne sont pas incluses dans les agrégats de cette édition.`,
  },
  {
    q: `Peut-on télécharger et citer les données de l'édition ?`,
    a: `Oui. Les données publiques de l'édition ${editionLabel} sont disponibles en JSON et en CSV. La citation proposée précise l'édition, la taille de l'échantillon et son URL stable. Aucune licence de réutilisation plus large n'est déclarée à ce stade.`,
  },
  {
    q: `Pourquoi certaines fiches affichent-elles cinq sections et d'autres jusqu'à treize ?`,
    a: `Les fiches de juin 2026 conservent la grille historique exacte de cinq sections utilisée lors de leur publication. Les fiches courantes affichent uniquement les sections réellement notées, au moins cinq parmi les treize axes connus. Les notes absentes ne sont ni remplacées par zéro ni recalculées silencieusement.`,
  },
  {
    q: `Quelles sont les limites des notes du Baromètre ?`,
    a: `Les notes sont des instantanés indicatifs fondés sur les données disponibles lors de l'analyse. Elles ne constituent ni une expertise immobilière ni un conseil en investissement.${lastDateFmt ? ` Dernière analyse publiée : ${lastDateFmt}.` : ''}`,
  },
  {
    q: `Que mesure le relevé des capitales régionales ?`,
    a: `Le relevé d'août 2026 publie une annonce avec prix et surface dans 17 chefs-lieux sur 18 : 15 avec un DPE A-G et 2 sans DPE renseigné. Il ne publie aucun score Score-Immo et ne représente ni un prix moyen de la ville ni un indice de marché.`,
  },
];

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${canonical}#edition-${latestEdition.month}`,
  identifier: `${canonical}#edition-${latestEdition.month}`,
  version: latestEdition.month,
  name: `Baromètre ${BRAND_NAME}, édition ${editionLabel} : ${total} analyses d'annonces`,
  description: `Échantillon descriptif de ${total} annonces immobilières analysées dans ${regions} régions françaises en ${editionLabel}. Score moyen de l'édition : ${avg}/100.`,
  url: canonical,
  isAccessibleForFree: true,
  creator: { '@id': ORGANIZATION_ID },
  ...(lastDate ? { dateModified: lastDate } : {}),
  spatialCoverage: { '@type': 'Place', name: 'France' },
  temporalCoverage: latestEdition.month,
  keywords: ['annonces immobilières analysées', 'score immobilier', 'DPE', 'échantillon immobilier'],
  measurementTechnique: `Instantanés datés produits avec la méthode résidentielle courante ; chaque fiche publie ${sectionCountPhrase} selon les données disponibles lors de son analyse.`,
  distribution: [
    {
      '@type': 'DataDownload',
      name: `Données JSON, édition ${editionLabel}`,
      encodingFormat: 'application/json',
      contentUrl: editionExport.downloads.json,
    },
    {
      '@type': 'DataDownload',
      name: `Données CSV, édition ${editionLabel}`,
      encodingFormat: 'text/csv',
      contentUrl: editionExport.downloads.csv,
    },
  ],
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'Annonces analysées', value: total },
    { '@type': 'PropertyValue', name: 'Score moyen de l’échantillon (0-100)', value: avg },
    { '@type': 'PropertyValue', name: 'Score médian de l’échantillon (0-100)', value: insights.medianScore },
    { '@type': 'PropertyValue', name: 'Régions couvertes', value: regions },
    { '@type': 'PropertyValue', name: 'Sections visibles par fiche', value: sectionCountLabel },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const regionalCapitalDatasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${canonical}#capitales-regionales-2026-08`,
  identifier: `${canonical}#capitales-regionales-2026-08`,
  version: capitalesAout.mois,
  name: `Repères d'annonces dans les capitales régionales, août 2026`,
  description: `Une annonce d'août 2026 avec prix et surface dans 17 chefs-lieux régionaux : 15 avec un DPE A-G et 2 sans DPE renseigné. Prix affichés, sans score Score-Immo et sans extrapolation au marché local.`,
  url: canonical,
  isAccessibleForFree: true,
  creator: { '@id': ORGANIZATION_ID },
  dateModified: capitalesAout.capture_date,
  temporalCoverage: capitalesAout.mois,
  spatialCoverage: allCapitalObservations.map(({ capitale, region }) => ({
    '@type': 'Place',
    name: `${capitale}, ${region}`,
  })),
  measurementTechnique: `${capitalesAout.selection_policy} ${capitalesAout.partial_selection_policy}`,
  citation: [
    { '@type': 'Dataset', name: capitalesAout.official_geography.name, url: capitalesAout.official_geography.url },
    { '@type': 'WebSite', name: capitalesAout.source.name, url: capitalesAout.source.url },
  ],
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE_URL}${capitalJsonUrl}` },
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `${SITE_URL}${capitalCsvUrl}` },
  ],
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'Capitales observées', value: allCapitalObservations.length },
    { '@type': 'PropertyValue', name: 'Observations avec DPE A-G', value: capitalObservations.length },
    { '@type': 'PropertyValue', name: 'Observations sans DPE renseigné', value: partialCapitalObservations.length },
    { '@type': 'PropertyValue', name: 'Prix affiché', unitText: 'EUR' },
    { '@type': 'PropertyValue', name: 'Prix affiché au m²', unitText: 'EUR par m²' },
    { '@type': 'PropertyValue', name: 'Surface', unitText: 'm²' },
    { '@type': 'PropertyValue', name: 'Classe DPE' },
  ],
};

const jsonLd: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonical,
    inLanguage: 'fr-FR',
    isPartOf: { '@id': WEBSITE_ID },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.si-article-title', '.bar-short-answer'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    numberOfItems: total,
    itemListElement: current.map((fiche, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${fiche.ville} · ${typeLabel(fiche.type_bien)} ${fiche.surface} m² (${fiche.score_global}/100)`,
      url: `${SITE_URL}/barometre/${fiche.slug}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Baromètre', item: canonical },
    ],
  },
  datasetSchema,
  regionalCapitalDatasetSchema,
  faqSchema,
];
---
<BaseLayout {title} {description} {canonical} {jsonLd} image="/assets/barometre-og.svg">
  <link slot="head" rel="preload" href={dmSans800Url} as="font" type="font/woff2" crossorigin="anonymous" />
  <link slot="head" rel="preload" href={inter400Url} as="font" type="font/woff2" crossorigin="anonymous" />
  <div class="bar-page">
    <div class="si-container">
      <nav class="si-breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span> &rsaquo; </span><span>Le Baromètre immobilier</span>
      </nav>
    </div>

    <section class="bar-hero" aria-labelledby="bar-title">
      <div class="si-container bar-hero-grid">
        <header class="bar-hero-copy">
          <p class="bar-edition">Édition {editionLabel} · Données mises à jour</p>
          <h1 class="si-article-title" id="bar-title">Le Baromètre immobilier Score-Immo</h1>
          <p class="bar-short-answer">Cette édition décrit <strong>{total} annonces réellement analysées</strong> dans {regions} régions. Leur score moyen est de <strong>{avg}/100</strong>, avec une médiane de {insights.medianScore}/100.</p>
          <p class="bar-hero-limit">Il s'agit d'un échantillon descriptif d'annonces, pas d'un indice des prix ni d'une représentation du marché immobilier français.</p>
          <div class="bar-hero-actions">
            <a class="bar-button bar-button-primary" href="#analyses">Explorer les {total} analyses</a>
            <a class="bar-button bar-button-secondary" href="/methodologie">Comprendre la méthode</a>
          </div>
        </header>

        <aside class="bar-score-panel" data-barometre-insights aria-label={`Synthèse de l'édition ${editionLabel}`}>
          <p class="bar-panel-kicker">Score moyen de l'échantillon</p>
          <p class="bar-main-score"><strong>{avg}</strong><span>/100</span></p>
          <dl class="bar-score-definitions">
            <div><dt>Médiane</dt><dd>{insights.medianScore}/100</dd></div>
            <div><dt>Plage observée</dt><dd>{insights.minimumScore} à {insights.maximumScore}</dd></div>
          </dl>
          <div class="bar-distribution" aria-label="Distribution des scores">
            {insights.scoreBands.map((band) => (
              <div class="bar-distribution-row">
                <span>{band.label}</span>
                <span class="bar-distribution-track" aria-hidden="true">
                  <span style={`--w:${band.count ? Math.max((band.count / total) * 100, 7) : 0}%`}></span>
                </span>
                <strong>{band.count}</strong>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <div class="si-container">
      <dl class="bar-proof-strip" aria-label="Périmètre de l'édition">
        <div><dt>Échantillon</dt><dd>{total} annonces</dd></div>
        <div><dt>Couverture</dt><dd>{regions} régions</dd></div>
        <div><dt>Grille visible</dt><dd>{sectionCountPhrase}</dd></div>
        <div><dt>Dernière analyse</dt><dd>{lastDateFmt}</dd></div>
      </dl>

      <section class="bar-section bar-capitals" aria-labelledby="bar-capitals-title">
        <div class="bar-section-heading bar-section-heading-row">
          <div>
            <p class="bar-overline">Couverture géographique · août 2026</p>
            <h2 id="bar-capitals-title">Repères dans les capitales régionales</h2>
            <p>Une annonce avec prix et surface observée dans <strong>17 chefs-lieux sur 18</strong> : 15 avec DPE renseigné et 2 sans DPE renseigné. Ce relevé compare des prix affichés, pas des prix de vente, et reste volontairement sans score Score-Immo.</p>
          </div>
          <p class="bar-result-count">Relevé du 31 août 2026</p>
        </div>

        <div class="bar-capital-layout">
          <figure class="bar-capital-map">
            <div class="bar-card-heading">
              <div>
                <p class="bar-overline">Carte de couverture</p>
                <h3>13 chefs-lieux en métropole et Corse</h3>
              </div>
              <span class="bar-card-note">Position des villes</span>
            </div>
            <svg viewBox="0 0 100 100" role="img" aria-labelledby="capital-map-title capital-map-desc">
              <title id="capital-map-title">Capitales régionales couvertes en métropole et en Corse</title>
              <desc id="capital-map-desc">Schéma de position des treize chefs-lieux disposant d'une annonce complète dans le relevé d'août 2026.</desc>
              <path class="bar-map-shape" d="M43 5 L67 10 L91 34 L82 71 L59 94 L31 88 L10 62 L14 32 L27 13 Z" />
              {capitalMapPoints.map((observation) => (
                <g class="bar-map-point" transform={`translate(${observation.x} ${observation.y})`}>
                  <circle r="2.8" />
                  <title>{observation.capitale} · {observation.prix_m2.toLocaleString('fr-FR')} €/m² · DPE {observation.dpe}</title>
                </g>
              ))}
            </svg>
            <figcaption>Schéma de localisation, sans représentation des frontières régionales. Les positions sont celles des chefs-lieux officiels, pas celles des biens.</figcaption>
            <div class="bar-overseas-capitals" aria-label="Chefs-lieux ultramarins observés">
              {overseasCapitalObservations.map((observation) => (
                <span><strong>{observation.capitale}</strong><small>{observation.region} · {observation.dpe ? `DPE ${observation.dpe}` : 'DPE non renseigné'}</small></span>
              ))}
            </div>
          </figure>

          <article class="bar-capital-data">
            <div class="bar-card-heading">
              <div>
                <p class="bar-overline">17 observations datées</p>
                <h3>Prix affiché et DPE par capitale</h3>
              </div>
            </div>
            <div class="bar-table-wrap bar-capital-table">
              <table>
                <thead><tr><th>Capitale</th><th>Annonce</th><th>Prix affiché</th><th>Prix/m²</th><th>DPE</th></tr></thead>
                <tbody>
                  {allCapitalObservations.map((observation) => (
                    <tr>
                      <th scope="row"><strong>{observation.capitale}</strong><small>{observation.region} · {observation.code_postal}</small></th>
                      <td>{typeLabel(observation.type_bien)} · {observation.surface.toLocaleString('fr-FR')} m²</td>
                      <td>{observation.prix_affiche.toLocaleString('fr-FR')} €</td>
                      <td><strong>{observation.prix_m2.toLocaleString('fr-FR')} €/m²</strong></td>
                      <td>
                        {observation.dpe
                          ? <span class={`bar-dpe-pill bar-dpe-${observation.dpe.toLowerCase()}`}>{observation.dpe}</span>
                          : <span class="bar-dpe-missing">Non renseigné</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </article>
        </div>

        <div class="bar-capital-method">
          <div>
            <strong>Règle de sélection</strong>
            <p>{capitalesAout.selection_policy} {capitalesAout.partial_selection_policy} Une observation décrit une annonce, jamais le niveau de prix de la ville.</p>
          </div>
          <div>
            <strong>2 DPE non renseignés, 1 absence</strong>
            <p>Cayenne et Saint-Denis conservent leur prix et leur surface sans DPE. {unavailableCapitals.map(({ capitale, raison }) => `${capitale} : ${raison}`).join(' ')}</p>
          </div>
          <div class="bar-capital-downloads">
            <a href={capitalJsonUrl} download>JSON</a>
            <a href={capitalCsvUrl} download>CSV</a>
          </div>
        </div>
        <p class="bar-capital-source">Sources consultées le 31 août 2026 : <a href={capitalesAout.official_geography.url}>API Découpage administratif</a> pour les chefs-lieux et codes postaux ; <a href={capitalesAout.source.url}>Bien’ici</a> pour les caractéristiques publiques de l'annonce. Aucun identifiant vendeur, contact, photo, adresse exacte ou URL d'annonce n'est publié.</p>
      </section>

      <section class="bar-section" aria-labelledby="bar-reading-title">
        <div class="bar-section-heading">
          <p class="bar-overline">Lecture de l'édition</p>
          <h2 id="bar-reading-title">Ce que montre l'échantillon, édition {editionLabel}</h2>
          <p>Les comparaisons ci-dessous décrivent uniquement ces {total} annonces. Chaque groupe affiche sa taille pour éviter toute extrapolation.</p>
        </div>

        <div class="bar-insight-grid">
          <article class="bar-insight-card bar-insight-card-wide">
            <div class="bar-card-heading">
              <div>
                <p class="bar-overline">Comparaison descriptive</p>
                <h3>Appartements et maisons</h3>
              </div>
              <span class="bar-card-note">Prix demandés, pas prix de vente</span>
            </div>
            <div class="bar-table-wrap">
              <table>
                <thead>
                  <tr><th>Type</th><th>Annonces</th><th>Score moyen</th><th>Score médian</th><th>Prix demandé médian</th></tr>
                </thead>
                <tbody>
                  {insights.propertyTypes.map((group) => (
                    <tr>
                      <th scope="row">{group.label}</th>
                      <td>{group.count}</td>
                      <td>{group.averageScore}/100</td>
                      <td>{group.medianScore}/100</td>
                      <td>{group.medianPriceM2?.toLocaleString('fr-FR')} €/m²</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </article>

          <article class="bar-insight-card">
            <div class="bar-card-heading">
              <div>
                <p class="bar-overline">Énergie</p>
                <h3>DPE de l'échantillon</h3>
              </div>
            </div>
            <ul class="bar-dpe-list" aria-label="Répartition des classes DPE">
              {insights.dpe.map((item) => (
                <li class={`bar-dpe-row${item.count === 0 ? ' is-empty' : ''}`}>
                  <span class={`bar-dpe-key bar-dpe-${item.label.toLowerCase()}`}>{item.label}</span>
                  <span class="bar-dpe-track" aria-hidden="true">
                    <span
                      class={`bar-dpe-fill bar-dpe-${item.label.toLowerCase()}`}
                      style={`--w:${Math.round((item.count / dpePeak) * 100)}%`}
                    ></span>
                  </span>
                  <span class="bar-dpe-count">
                    <strong>{item.count}</strong>
                    <small>{item.count === 1 ? 'annonce' : 'annonces'}</small>
                  </span>
                </li>
              ))}
            </ul>
            <dl class="bar-dpe-summary">
              <div><dt>Classes A ou B</dt><dd>{dpeCount(['A', 'B'])}</dd></div>
              <div><dt>Classes C à E</dt><dd>{dpeCount(['C', 'D', 'E'])}</dd></div>
              <div><dt>Classes F ou G</dt><dd>{dpeCount(['F', 'G'])}</dd></div>
            </dl>
          </article>

          <article class="bar-insight-card">
            <div class="bar-card-heading">
              <div>
                <p class="bar-overline">Couverture</p>
                <h3>{regions} régions représentées</h3>
              </div>
            </div>
            <ul class="bar-region-list">
              {insights.regions.map((region) => (
                <li>
                  {region.count >= REGION_MIN
                    ? <a href={`/barometre/region/${slugifyRegion(region.name)}`}>{region.name}</a>
                    : <span>{region.name}</span>}
                  <strong>{region.count}</strong>
                </li>
              ))}
            </ul>
            <p class="bar-card-footnote">Un lien régional apparaît à partir de {REGION_MIN} fiches dans une édition homogène.</p>
          </article>
        </div>
      </section>

      <aside class="bar-inline-cta" aria-label="Analyser une annonce">
        <div>
          <p class="bar-overline">Passer du baromètre à ton projet</p>
          <h2>Une annonce mérite une vérification complète ?</h2>
