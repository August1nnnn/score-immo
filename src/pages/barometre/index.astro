  .bar-dpe-a { background: #bbf7d0; } .bar-dpe-b { background: #d9f99d; } .bar-dpe-c { background: #fef08a; } .bar-dpe-d { background: #fed7aa; } .bar-dpe-e { background: #fdba74; } .bar-dpe-f { background: #fecaca; } .bar-dpe-g { background: #fca5a5; }
  .bar-dpe-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin: 1.2rem 0 0; }
