---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BRAND_NAME, ORGANIZATION_ID, SITE_URL } from '@/data/entity';
import demo from '@/data/public-demo.json';
import AnalyzerBox from '@/components/AnalyzerBox.astro';

const canonical = `${SITE_URL}/pro`;
const appUrl = 'https://app.score-immo.fr/go/checkout/premium';
const demoUrl = '/pro/exemple';
const trialUrl = 'https://app.score-immo.fr/pro/essai';
const money = (value: number) => value.toLocaleString('fr-FR');

const title = `${BRAND_NAME} Pro : l'outil d'analyse des mandataires`;
const description = "Agents et mandataires : préparez vos échanges vendeurs avec un rapport d'analyse immobilière. Premium à 79 €/mois, analyses illimitées et PDF avec votre logo. Exemple fictif en accès libre.";

const faq = [
  { q: "Score-Immo, c'est pour quels professionnels de l'immobilier ?", a: "Pour les mandataires immobiliers, les agents et les négociateurs qui veulent documenter leur analyse avec les données disponibles pour le bien." },
  { q: "Qu'est-ce qui rend le rapport crédible face à un vendeur ?", a: "Il réunit des données publiques et ouvertes, indique leur source et signale les informations indisponibles ou insuffisamment fiables. La négociation peut ainsi s'appuyer sur des éléments vérifiables." },
  { q: "Puis-je remettre un rapport à ma marque ?", a: "Oui, Premium à 79 €/mois inclut les analyses illimitées et le PDF co-brandé avec votre nom et votre logo, à renseigner dans votre profil professionnel. Recherche à 29 €/mois inclut 60 analyses ; la personnalisation du PDF avec votre logo est incluse dans Premium." },
  { q: "Est-ce un logiciel d'avis de valeur complet ?", a: "Score-Immo est un support d'analyse pour préparer votre estimation et vos échanges. Le mode Vente présente le positionnement du prix et les références disponibles. Il ne remplace pas votre connaissance du terrain, la visite ni une expertise de valeur et ne constitue pas un avis de valeur complet." },
  { q: "Combien de temps prend une analyse ?", a: "Le délai dépend du bien et des sources accessibles. Après l'achat d'une formule adaptée, le rapport présente les informations disponibles et leur couverture." },
  { q: "Puis-je voir un rapport avant de souscrire ?", a: "Oui. L'exemple vendeur est accessible librement. Un premier rapport en mode Vente, avec votre nom et votre logo, est offert aux professionnels après vérification de leur activité et de leur rattachement. Cette offre est limitée à un rapport par entreprise, sans carte bancaire ni abonnement automatique. Les analyses suivantes sont payantes." },
];

const jsonLd = [
  {
    "@context": "https://schema.org", "@type": "Service",
    name: "Score-Immo Pro", serviceType: "Outil d'analyse immobilière pour mandataires",
    provider: { "@id": ORGANIZATION_ID },
    areaServed: { "@type": "Country", name: "France" },
    description, url: canonical,
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: faq.map(f => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Score-Immo Pro", item: canonical },
    ],
  },
];
---
<BaseLayout {title} {description} {canonical} {jsonLd}>
  <section class="si-section">
    <div class="si-container">
      <nav class="si-breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span> &rsaquo; </span><span>Score-Immo Pro</span>
      </nav>

      <header class="pro-hero">
        <div>
          <p class="pro-kicker">Pour les agents et mandataires immobiliers</p>
          <h1 class="pro-h1">Un rapport à votre marque pour vos échanges vendeurs</h1>
          <p class="pro-lead">Préparez votre argumentation sur le prix avec les références disponibles, le DPE, les risques et l'environnement du bien.</p>
          <p class="pro-offer"><strong>Premium : 79&nbsp;€/mois</strong><br />Analyses illimitées et PDF avec votre nom et votre logo.</p>
          <div class="pro-actions">
            <a class="pro-btn pro-btn-primary" href={trialUrl}>Demander mon rapport vendeur offert</a>
            <a class="pro-btn pro-btn-ghost" href={demoUrl}>Voir l'exemple vendeur</a>
            <a class="pro-btn pro-btn-ghost" href={appUrl}>Choisir Premium à 79 €/mois</a>
          </div>
          <p class="pro-terms">Essai réservé aux professionnels vérifiés, une fois par entreprise, sans carte bancaire ni abonnement automatique. Premium : abonnement mensuel renouvelable, annulable à tout moment.</p>
        </div>
        <aside class="pro-preview" aria-label="Aperçu fictif du rapport vendeur">
          <div class="pro-preview-brand"><span class="pro-preview-logo" aria-label="Logo de démonstration">AD</span><div><strong>Agence de démonstration</strong><br /><span>Exemple d'identité pour votre PDF</span></div></div>
          <p class="pro-preview-notice">Données et identité entièrement fictives</p>
          <h2>Préparer le positionnement du prix</h2>
          <p>{demo.report.title}<br />{demo.report.city}</p>
          <dl><div><dt>Prix affiché</dt><dd>{money(demo.report.pricePerSqm)} €/m²</dd></div><div><dt>Médiane du secteur</dt><dd>{money(demo.report.medianLocal)} €/m²</dd></div></dl>
          <p>Comparer les caractéristiques du bien, vérifier les références et relever les points à expliquer au vendeur.</p>
          <a href={demoUrl}>Explorer le rapport en mode Vente</a>
        </aside>
      </header>
      <section class="pro-block"><AnalyzerBox blog="pro" medium="pro_landing" professionalTrial={true} /></section>

      <section class="pro-block">
        <h2 class="pro-h2">Un support pour votre analyse professionnelle</h2>
        <div class="pro-cards">
          <div class="pro-card"><h3>Données traçables</h3><p>Le rapport relie les informations disponibles à leur source et indique les limites de couverture. Votre analyse devient vérifiable.</p></div>
          <div class="pro-card"><h3>À votre marque</h3><p>Premium inclut le PDF co-brandé, avec votre nom et votre logo. Renseignez votre profil professionnel puis exportez le rapport pour votre client.</p></div>
          <div class="pro-card"><h3>Préparer une analyse</h3><p>Collez le lien d'une annonce, obtenez un rapport complet : prix au m² réels, DPE, risques, environnement et un score sur 100.</p></div>
          <div class="pro-card"><h3>Pour documenter le prix</h3><p>Transformez la négociation de prix en discussion de données. Présentez les références disponibles et les points à vérifier avec le vendeur.</p></div>
        </div>
      </section>

      <section class="pro-block">
        <h2 class="pro-h2">Comment ça marche</h2>
        <ol class="pro-steps">
          <li><strong>Demandez votre essai professionnel</strong> : confirmez votre compte, renseignez votre nom, votre logo et le SIRET de votre activité. Votre rattachement professionnel est vérifié avant l'accès au rapport offert.</li>
          <li><strong>Analysez votre propre bien</strong> en mode Vente : collez le lien de l'annonce, vérifiez les informations extraites puis préparez votre premier rapport.</li>
          <li><strong>Exportez le PDF à votre marque</strong> pour préparer l'échange avec votre client. Choisissez ensuite un abonnement selon votre usage.</li>
        </ol>
      </section>

      <section class="pro-block">
        <p class="pro-note">Le rapport documente votre analyse : il ne remplace pas la visite, les diagnostics ni une expertise de valeur. Les références et les sections disponibles dépendent du bien, de la précision de son adresse et de la couverture des sources. Il ne constitue pas un avis de valeur complet.</p>
      </section>

      <section class="pro-block">
        <h2 class="pro-h2">Les informations recherchées pour le rapport</h2>
        <ul class="pro-data">
          <li>Ventes de référence du secteur (DVF), selon les données disponibles</li>
          <li>Position vs marché (sur ou sous-évalué)</li>
          <li>Performance énergétique (DPE)</li>
          <li>Risques naturels et technologiques</li>
          <li>Environnement, commerces et transports</li>
          <li>Profil socio-démographique de la commune</li>
          <li>Un score global sur 100 et un verdict</li>
        </ul>
        <p class="pro-note">Découvrez des analyses publiées dans <a href="/barometre">le Baromètre Score-Immo</a>, notre <a href="/methodologie">méthodologie</a> et nos guides métier dans <a href="/blogs/pro">l'espace mandataires</a>.</p>
      </section>

      <section class="pro-block pro-pricing" id="offres-pro">
        <h2 class="pro-h2">Choisissez selon votre usage</h2>
        <p><strong>Premium à 79&nbsp;€/mois :</strong> analyses illimitées, modes Achat et Vente, PDF co-brandé avec votre nom et votre logo.</p>
        <p><strong>Recherche à 29&nbsp;€/mois :</strong> 60 analyses par mois, export PDF et partage. La personnalisation du PDF avec votre logo est incluse dans Premium.</p>
        <p>Ces abonnements mensuels se renouvellent automatiquement et sont annulables à tout moment depuis votre compte. Vous pouvez consulter l'exemple fictif avant de choisir.</p>
        <div class="pro-actions">
          <a class="pro-btn pro-btn-primary" href={appUrl}>Choisir Premium à 79 €/mois</a>
          <a class="pro-btn pro-btn-ghost" href="https://app.score-immo.fr/go/checkout/search">Choisir Recherche à 29 €/mois</a>
          <a class="pro-btn pro-btn-ghost" href="/tarifs">Voir les tarifs</a>
        </div>
      </section>

      <section class="pro-block">
        <h2 class="pro-h2">Faire découvrir Score-Immo à vos clients</h2>
        <p>Agents, mandataires, courtiers ou créateurs de contenu : commencez par montrer l'<a href={demoUrl}>exemple vendeur</a> et la <a href="/methodologie">méthodologie et ses limites</a>. Un rapport ne remplace pas une visite ou une expertise technique.</p>
        <p>Selon le projet de votre interlocuteur, partagez notre guide pour <a href="/blogs/guides/estimation-immobiliere-methodes-juste-prix">vérifier si le prix demandé est cohérent</a> ou pour <a href="/blogs/guides/analyser-annonce-immobiliere-comme-pro">préparer une visite à partir de l'annonce</a>.</p>
        <p>Exemple de présentation : « Avant votre prochaine visite, vous pouvez consulter cette démonstration d'analyse immobilière. Elle montre les informations disponibles et leurs limites. L'analyse personnalisée est payante. »</p>
        <p><a href={demoUrl}>Ouvrir l'exemple vendeur à partager</a></p>
        <p>Pour explorer toutes les rubriques, consultez aussi la <a href="https://app.score-immo.fr/r/demo">démonstration interactive côté acheteur</a>, avec ses données fictives.</p>
      </section>

      <section class="pro-block">
        <h2 class="pro-h2">Questions fréquentes</h2>
        {faq.map(f => (
          <div class="pro-faq"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </section>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .si-breadcrumb { font-size: 0.875rem; color: var(--si-muted-foreground, #64748B); margin: 1rem 0 2rem; }
  .si-breadcrumb a { color: var(--si-muted-foreground, #64748B); text-decoration: none; }
  .pro-hero { max-width: 70rem; margin: 0 auto 3rem; display: grid; grid-template-columns: minmax(0,1.3fr) minmax(0,1fr); gap: 3rem; align-items: center; text-align: left; }
  .pro-kicker { font-family: var(--si-font-heading,'DM Sans',sans-serif); font-size: 0.875rem; font-weight: 600; color: var(--si-muted-foreground,#64748B); margin: 0 0 0.75rem; }
  .pro-h1 { font-family: var(--si-font-heading,'DM Sans',sans-serif); font-size: clamp(2rem,5vw,3rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.025em; margin: 0 0 1rem; color: var(--si-foreground); }
  .pro-lead { font-size: 1.15rem; line-height: 1.7; color: var(--si-muted-foreground,#64748B); margin: 0 0 1.75rem; }
  .pro-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
  .pro-hero .pro-actions { justify-content: flex-start; }
  .pro-offer { line-height: 1.6; margin: 0 0 1rem; }
  .pro-offer strong { font-family: var(--si-font-heading,'DM Sans',sans-serif); font-size: 1.5rem; }
  .pro-terms { color: var(--si-muted-foreground,#64748B); font-size: .8rem; line-height: 1.6; margin: 1rem 0 0; }
  .pro-preview { background: var(--si-card,#fff); border: 1px solid var(--si-border,#E2E8F0); border-radius: var(--si-radius-xl,1rem); padding: 1.5rem; line-height: 1.6; }
  .pro-preview-brand { display: flex; align-items: center; gap: .75rem; font-size: .875rem; }
  .pro-preview-brand span:not(.pro-preview-logo) { color: var(--si-muted-foreground,#64748B); font-size: .75rem; }
  .pro-preview-logo { display: flex; align-items: center; justify-content: center; width: 3rem; height: 3rem; flex-shrink: 0; border-radius: var(--si-radius,.75rem); color: var(--si-accent,#3B82F6); background: var(--si-muted,#F1F5F9); font-weight: 700; }
  .pro-preview h2 { font-family: var(--si-font-heading,'DM Sans',sans-serif); font-size: 1.3rem; font-weight: 700; margin: 1.5rem 0 .5rem; }
  .pro-preview p { font-size: .875rem; color: var(--si-muted-foreground,#64748B); }
  .pro-preview .pro-preview-notice { font-size: .75rem; margin-top: 1rem; }
  .pro-preview dl { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--si-border,#E2E8F0); border-bottom: 1px solid var(--si-border,#E2E8F0); }
  .pro-preview dt { font-size: .75rem; color: var(--si-muted-foreground,#64748B); }
  .pro-preview dd { font-family: var(--si-font-heading,'DM Sans',sans-serif); font-size: 1.25rem; font-weight: 700; }
  .pro-preview a { display: inline-flex; align-items: center; min-height: 44px; color: var(--si-accent,#3B82F6); text-decoration: underline; margin-top: .75rem; }
  .pro-btn:focus-visible, .pro-preview a:focus-visible { outline: 2px solid var(--si-accent,#3B82F6); outline-offset: 4px; }
  @media (max-width: 800px) { .pro-hero { grid-template-columns: minmax(0,1fr); gap: 2rem; } }
  .pro-btn { display: inline-flex; align-items: center; justify-content: center; height: 2.9rem; padding: 0 1.6rem; border-radius: var(--si-radius,0.75rem); font-weight: 600; text-decoration: none; transition: transform .15s, opacity .15s; }
  .pro-btn:hover { transform: translateY(-1px); }
  .pro-btn-primary { background: var(--si-accent,#3B82F6); color: #fff; }
  .pro-btn-ghost { background: var(--si-card,#fff); color: var(--si-foreground); border: 1px solid var(--si-border,#E2E8F0); }
  .pro-block { max-width: 52rem; margin: 0 auto 3rem; }
  .pro-h2 { font-family: var(--si-font-heading,'DM Sans',sans-serif); font-size: clamp(1.5rem,3.5vw,2rem); font-weight: 700; margin: 0 0 1.5rem; text-align: center; color: var(--si-foreground); }
  .pro-cards { display: grid; grid-template-columns: repeat(auto-fit,minmax(230px,1fr)); gap: 1rem; }
  .pro-card { padding: 1.5rem; border: 1px solid var(--si-border,#E2E8F0); border-radius: var(--si-radius-xl,1rem); background: var(--si-card,#fff); }
  .pro-card h3 { font-family: var(--si-font-heading,'DM Sans',sans-serif); font-size: 1.1rem; font-weight: 700; margin: 0 0 0.5rem; color: var(--si-foreground); }
  .pro-card p { margin: 0; line-height: 1.6; color: var(--si-muted-foreground,#64748B); font-size: 0.95rem; }
  .pro-steps { counter-reset: s; list-style: none; padding: 0; display: grid; gap: 1rem; }
  .pro-steps li { position: relative; padding: 1.1rem 1.25rem 1.1rem 3.5rem; border: 1px solid var(--si-border,#E2E8F0); border-radius: var(--si-radius,0.75rem); background: var(--si-card,#fff); line-height: 1.6; }
  .pro-steps li::before { counter-increment: s; content: counter(s); position: absolute; left: 1rem; top: 1.1rem; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--si-accent,#3B82F6); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .pro-data { columns: 2; column-gap: 2rem; padding-left: 1.2rem; line-height: 1.9; }
  @media (max-width: 520px) { .pro-data { columns: 1; } }
  .pro-note { margin-top: 1.5rem; color: var(--si-muted-foreground,#64748B); }
  .pro-note a, .pro-pricing p a { color: var(--si-accent,#3B82F6); }
  .pro-pricing { text-align: center; padding: 2rem; border: 1px solid var(--si-border,#E2E8F0); border-radius: var(--si-radius-xl,1rem); background: var(--si-muted,#F1F5F9); }
  .pro-pricing p { max-width: 38rem; margin: 0 auto 1.5rem; line-height: 1.7; }
  .pro-faq { margin-bottom: 1.25rem; }
  .pro-faq h3 { font-family: var(--si-font-heading,'DM Sans',sans-serif); font-size: 1.05rem; font-weight: 700; margin: 0 0 0.4rem; color: var(--si-foreground); }
  .pro-faq p { margin: 0; line-height: 1.65; color: var(--si-muted-foreground,#64748B); }
  @media (prefers-reduced-motion: reduce) { .pro-btn { transition: none; } .pro-btn:hover { transform: none; } }
</style>
