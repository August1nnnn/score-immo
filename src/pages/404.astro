---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Page introuvable | Score-Immo';
const description = "Cette adresse n'existe pas ou n'est plus disponible. Retrouvez les outils et guides immobiliers de Score-Immo.";
---

<BaseLayout {title} {description} noindex>
  <section class="si-not-found" aria-labelledby="not-found-title">
    <div class="si-not-found__code" aria-hidden="true">404</div>
    <h1 id="not-found-title">Page introuvable</h1>
    <p>
      Cette adresse n'existe pas ou n'est plus disponible. Tu peux revenir à
      l'accueil ou consulter nos guides pour poursuivre ton analyse.
    </p>
    <div class="si-not-found__actions">
      <a class="si-not-found__primary" href="/">Retour à l'accueil</a>
      <a class="si-not-found__secondary" href="/pages/guide">Voir les guides</a>
    </div>
  </section>
</BaseLayout>

<style>
  .si-not-found {
    width: min(680px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(5rem, 12vw, 9rem) 0;
    text-align: center;
  }

  .si-not-found__code {
    color: var(--si-accent, #2563eb);
    font: 800 clamp(4rem, 18vw, 8rem) / 0.9 'DM Sans', sans-serif;
    letter-spacing: -0.08em;
  }

  h1 {
    margin: 1.5rem 0 0.75rem;
    color: var(--si-foreground, #0f172a);
    font: 800 clamp(2rem, 6vw, 3.25rem) / 1.05 'DM Sans', sans-serif;
    letter-spacing: -0.04em;
  }

  p {
    max-width: 560px;
    margin: 0 auto;
    color: var(--si-muted-foreground, #475569);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .si-not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .si-not-found__actions a {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--si-accent, #2563eb);
    border-radius: 12px;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .si-not-found__primary {
    background: var(--si-accent, #2563eb);
    color: #fff;
  }

  .si-not-found__secondary {
    background: transparent;
    color: var(--si-accent, #2563eb);
  }

  .si-not-found__actions a:focus-visible {
    outline: 3px solid #f59e0b;
    outline-offset: 3px;
  }
</style>
