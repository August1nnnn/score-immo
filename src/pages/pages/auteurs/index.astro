---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Méthode éditoriale Score-Immo";
const description = "Découvrez comment Score-Immo documente, source, relit et corrige ses guides sur l'achat immobilier et l'analyse de biens.";

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://score-immo.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Méthode éditoriale", "item": "https://score-immo.fr/pages/auteurs" },
  ],
}];
---
<BaseLayout {title} {description} {jsonLd}>
  <section class="si-section">
    <div class="si-container" style="max-width:48rem;">
      <header class="si-authors-hub-header">
        <h1>Méthode éditoriale Score-Immo</h1>
        <p>Les guides sont publiés sous la responsabilité éditoriale de Score-Immo. Une personne n'est présentée comme auteur que lorsque son identité et son expérience peuvent être vérifiées.</p>
      </header>

      <div class="si-editorial-method">
        <section>
          <h2>Sources et méthode</h2>
          <p>Chaque contenu doit distinguer les données publiques, les observations propres à Score-Immo et les exemples indicatifs. Les sources, la période, l'échantillon et les limites doivent être indiqués lorsqu'un chiffre est publié.</p>
        </section>
        <section>
          <h2>Révision et corrections</h2>
          <p>Les contenus sont relus lorsque les règles, les sources ou les données évoluent. Une information à vérifier peut être signalée à <a href="mailto:contact@score-immo.fr">contact@score-immo.fr</a>.</p>
        </section>
        <section>
          <h2>Responsable de publication</h2>
          <p>Augustin Foucheres, entrepreneur individuel, SIREN 890 838 709. Les informations juridiques complètes figurent dans les <a href="/pages/mentions-legales">mentions légales</a>.</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .si-authors-hub-header { text-align: center; padding: 2rem 0 2.5rem; }
  .si-authors-hub-header h1 {
    font-family: var(--si-font-heading);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .si-authors-hub-header p {
    font-size: 1.05rem;
    color: var(--si-muted-foreground);
    max-width: 36rem;
    margin: 0 auto;
    line-height: 1.7;
  }
  .si-editorial-method { display: grid; gap: 1rem; }
  .si-editorial-method section {
    padding: 1.5rem;
    background: var(--si-card, #fff);
    border: 1px solid var(--si-border);
    border-radius: var(--si-radius-xl, 1rem);
  }
  .si-editorial-method h2 {
    font-family: var(--si-font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }
  .si-editorial-method p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--si-foreground);
  }
</style>
