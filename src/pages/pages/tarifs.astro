---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Pricing from '@/components/sections/Pricing.astro';

const title = "Tarifs Score-Immo - Rapports dès 4,99 €";
const description = "Rapport personnalisé dès 4,99 € : Analyse unique, Pack 3 9,99 € pour 3 rapports, Pack 10 19,99 € pour 10 rapports, Recherche 29 €/mois et Premium 79 €/mois. Démo complète gratuite.";
const canonical = "https://score-immo.fr/tarifs";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Score-Immo - Analyse immobilière",
    "description": "Rapport d'aide à la décision immobilière pouvant mobiliser plus de 230 points de données provenant de 10 sources publiques et ouvertes, selon le bien.",
    "brand": { "@type": "Brand", "name": "Score-Immo" },
    "offers": [
      {
        "@type": "Offer",
        "name": "Analyse unique",
        "price": "4.99",
        "priceCurrency": "EUR",
        "description": "1 rapport personnalisé, paiement unique, sans abonnement",
        "availability": "https://schema.org/InStock",
        "url": "https://app.score-immo.fr/go/checkout/unit_v2"
      },
      {
        "@type": "Offer",
        "name": "Pack 3",
        "price": "9.99",
        "priceCurrency": "EUR",
        "description": "3 analyses, paiement unique, sans engagement",
        "availability": "https://schema.org/InStock",
        "url": "https://app.score-immo.fr/go/checkout/pack_3"
      },
      {
        "@type": "Offer",
        "name": "Pack 10",
        "price": "19.99",
        "priceCurrency": "EUR",
        "description": "10 analyses, paiement unique, sans engagement",
        "availability": "https://schema.org/InStock",
        "url": "https://app.score-immo.fr/go/checkout/pack_10"
      },
      {
        "@type": "Offer",
        "name": "Recherche",
        "price": "29",
        "priceCurrency": "EUR",
        "description": "60 analyses par mois, sans engagement",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "29",
          "priceCurrency": "EUR",
          "billingDuration": "P1M",
          "unitText": "MONTH"
        },
        "availability": "https://schema.org/InStock",
        "url": "https://app.score-immo.fr/go/checkout/search"
      },
      {
        "@type": "Offer",
        "name": "Premium",
        "price": "79",
        "priceCurrency": "EUR",
        "description": "Analyses illimitées, PDF brandé à votre logo, modes Achat/Vente, sans engagement",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "79",
          "priceCurrency": "EUR",
          "billingDuration": "P1M",
          "unitText": "MONTH"
        },
        "availability": "https://schema.org/InStock",
        "url": "https://app.score-immo.fr/go/checkout/premium"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://score-immo.fr/" },
      { "@type": "ListItem", "position": 2, "name": "Tarifs", "item": "https://score-immo.fr/tarifs" }
    ]
  }
];
---
<BaseLayout {title} {description} {canonical} {jsonLd}>
  <Pricing />
  <p class="si-container" style="text-align:center;margin:2rem auto;"><a href="/exemple-rapport">Lire l’exemple complet de rapport</a></p>
</BaseLayout>
