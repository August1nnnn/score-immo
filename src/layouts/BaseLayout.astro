---
import { IOS_APP_ID } from '@/data/ios-app';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import IOSContextBanner from '@/components/IOSContextBanner.astro';
import { BRAND_NAME, organizationJsonLd } from '@/data/entity';
// Self-hosted fonts via @fontsource (eliminate fonts.googleapis CDN)
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/dm-sans/latin-800.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  showIOSBanner?: boolean;
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
  };
  jsonLd?: any[];
  bodyClass?: string;
}

const SITE = 'https://score-immo.fr';
// Strip .html et index.html du pathname pour un canonical propre (fix audit technique)
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');

function toAbsolute(url: string): string {
  if (!url) return `${SITE}/assets/og-default.svg`;
  if (url.startsWith('http://') || url.startsWith('https://')) return url;
  return SITE + (url.startsWith('/') ? url : `/${url}`);
}

const {
  title,
  description,
  image: imageProp,
  canonical = new URL(cleanPath, SITE).toString(),
  noindex = false,
  showIOSBanner = true,
  articleMeta,
  jsonLd = [],
  bodyClass = '',
} = Astro.props;

const image = toAbsolute(imageProp || '/assets/og-default.svg');
const siteName = BRAND_NAME;
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || '';
const structuredData = [organizationJsonLd, ...jsonLd];
---
<!doctype html>
<!-- 63060b7066def14c96d91ca1a94ff448 -->
<!-- 03788d815388bf30 -->
<html lang="fr">
  <head>
    <meta name="apple-itunes-app" content={`app-id=${IOS_APP_ID}`} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0F172A" />

    <!-- Preload critical resources (fonts self-hosted via @fontsource) -->
    <link rel="preload" href="/assets/scoreimmo.css?v=20260831-social-channels" as="style" />
    <link rel="stylesheet" href="/assets/scoreimmo.css?v=20260831-social-channels" />
    {articleMeta && imageProp && (
      <link rel="preload" as="image" href={toAbsolute(imageProp)} fetchpriority="high" />
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}

    <meta name="author" content={articleMeta?.author || BRAND_NAME} />
    {metaPixelId && <meta name="scoreimmo-meta-pixel-id" content={metaPixelId} />}

    <!-- Open Graph -->
    <meta property="og:type" content={articleMeta ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    {articleMeta?.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
    {articleMeta?.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
    {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- JSON-LD -->
    {structuredData.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <script is:inline src="/consent.js"></script>
    <script is:inline src="/ga4.js"></script>
    <script is:inline src="/meta-pixel.js"></script>

    <slot name="head" />
  </head>
  <body class={`si-page-bg si-body-text ${bodyClass}`}>
    <a href="#MainContent" class="sr-only focus:not-sr-only">Aller au contenu</a>

    <Header />

    <main id="MainContent" role="main">
      <slot />
      {showIOSBanner && (
        <div class="si-container" data-ios-banner-global style="max-width:64rem;padding-block:2rem 3rem;">
          <IOSContextBanner />
        </div>
      )}
    </main>

    <Footer />
    <CookieBanner />

    <!-- Micro-interactions ScoreImmo -->
    <script src="/attribution.js?v=20260904" defer></script>
    <script src="/assets/scoreimmo-interactions.js?v=20260818" defer></script>
    <script src="/track.js?v=20260827-lot2" defer></script>
  </body>
</html>
