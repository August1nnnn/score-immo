---
// Cookie banner RGPD (règle STACK-2026)
// CNIL : 3 boutons équilibrés, consent 13 mois, mesure Google gated
---
<div
  id="si-cookie-banner"
  class="si-cookie-banner"
  role="region"
  aria-labelledby="si-cookie-title"
  aria-describedby="si-cookie-description"
  hidden
>
  <div class="si-cookie-inner">
    <div class="si-cookie-text">
      <h2 id="si-cookie-title" class="si-cookie-title">Cookies et confidentialité</h2>
      <p id="si-cookie-description" class="si-cookie-long">La mesure d'audience et de l'efficacité de nos publicités reste désactivée sans votre accord. Nous ne personnalisons pas les annonces avec ce choix. Vous pouvez accepter ou refuser librement ; votre choix est conservé 13 mois.</p>
      <p class="si-cookie-short" aria-hidden="true">Mesure d'audience et publicitaire désactivée sans votre accord. Choix conservé 13 mois.</p>
    </div>
    <div class="si-cookie-actions">
      <button type="button" id="si-cookie-reject" class="si-cookie-action si-cookie-choice">Refuser</button>
      <a href="/pages/politique-de-confidentialite" class="si-cookie-action si-cookie-detail">Détails</a>
      <button type="button" id="si-cookie-accept" class="si-cookie-action si-cookie-choice">Accepter</button>
    </div>
  </div>
</div>

<style>
.si-cookie-banner {
  position: fixed;
  right: max(0.75rem, env(safe-area-inset-right));
  bottom: max(0.75rem, env(safe-area-inset-bottom));
  left: max(0.75rem, env(safe-area-inset-left));
  box-sizing: border-box;
  max-width: 860px;
  margin-inline: auto;
  background: #fff;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border: 1px solid #CBD5E1;
  border-radius: 1rem;
  box-shadow: 0 20px 54px rgba(15, 23, 42, 0.22);
  padding: 0.9rem 1rem;
  z-index: 9999;
  display: block;
  isolation: isolate;
}
.si-cookie-banner[hidden] { display: none; }
.si-cookie-short { display: none; }
.si-cookie-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 18rem;
  align-items: center;
  gap: 1rem;
}
.si-cookie-text { min-width: 0; }
.si-cookie-title {
  font-family: var(--si-font-heading, 'DM Sans', sans-serif);
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.2;
  margin: 0 0 0.2rem;
  color: #0F172A;
}
.si-cookie-text p {
  margin: 0;
  font-size: 0.8125rem;
  color: #475569;
  line-height: 1.45;
}
.si-cookie-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.4rem;
  width: 100%;
}
.si-cookie-action {
  display: inline-flex;
  min-width: 0;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  appearance: none;
  border: 1px solid transparent;
  border-radius: 0.7rem;
  padding: 0.55rem 0.4rem;
  font-family: var(--si-font-body, 'Inter', sans-serif);
  font-size: 0.8125rem;
  font-weight: 700;
  line-height: 1.1;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}
.si-cookie-choice {
  border-color: #0F172A;
  background: #0F172A;
  color: #fff;
}
.si-cookie-detail {
  border-color: #CBD5E1;
  background: #F8FAFC;
  color: #0F172A;
}
.si-cookie-action:focus-visible {
  outline: 3px solid #2563EB;
  outline-offset: 2px;
}
@media (hover: hover) {
  .si-cookie-choice:hover { background: #1E293B; }
  .si-cookie-detail:hover { border-color: #94A3B8; background: #F1F5F9; }
}
@media (max-width: 700px) {
  /* Compact on phones so the banner no longer hides the hero call to action. */
  .si-cookie-banner {
    right: max(0.5rem, env(safe-area-inset-right));
    bottom: max(0.5rem, env(safe-area-inset-bottom));
    left: max(0.5rem, env(safe-area-inset-left));
    padding: 0.7rem 0.75rem;
    border-radius: 0.9rem;
  }
  .si-cookie-inner {
    grid-template-columns: 1fr;
    gap: 0.55rem;
  }
  .si-cookie-title { font-size: 0.875rem; margin-bottom: 0.1rem; }
  .si-cookie-text p { font-size: 0.75rem; line-height: 1.35; }
  /* Short wording on phones; the full text stays on the policy page linked by « Détails ». */
  .si-cookie-long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .si-cookie-short { display: block; }
  .si-cookie-action { min-height: 40px; padding: 0.45rem 0.4rem; }
}
@media (max-width: 700px) and (max-height: 760px) {
  /* Short phones: the hero call to action sits low, so the banner moves to the top. */
  .si-cookie-banner { top: max(0.5rem, env(safe-area-inset-top)); bottom: auto; }
}
@media (max-width: 360px) {
  .si-cookie-banner { padding: 0.75rem; }
  .si-cookie-actions { gap: 0.3rem; }
  .si-cookie-action { font-size: 0.75rem; }
}
@media (prefers-reduced-motion: reduce) {
  .si-cookie-action { transition: none; }
}
</style>

<script is:inline>
(function(){
  function show(){ document.getElementById('si-cookie-banner')?.removeAttribute('hidden'); }
  function hide(){ document.getElementById('si-cookie-banner')?.setAttribute('hidden',''); }

  const consent = window.ScoreImmoConsent;
  const existing = consent?.getStatus() || null;
  const advertising = consent?.getAdvertisingStatus() || null;
  if (!existing || !advertising) show();

  document.getElementById('si-cookie-accept')?.addEventListener('click', () => {
    consent?.setAllStatus('accepted');
    hide();
  });
  document.getElementById('si-cookie-reject')?.addEventListener('click', () => {
    consent?.setAllStatus('rejected');
    hide();
  });

  window.siOpenCookieBanner = show;
})();
</script>
