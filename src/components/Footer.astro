---
import { SOCIAL_PROFILES } from '@/data/entity';

const year = new Date().getFullYear();
---
<footer class="si-footer">
  <div class="si-container">
    <div class="si-footer-inner">
      <div class="si-footer-left">
        <div class="si-footer-logo"><span>SI</span></div>
        <span>Score-Immo &copy; {year} - Données publiques, non contractuel</span>
      </div>
      <div class="si-footer-links si-footer-links--compact">
        <a href="/tarifs">Tarifs</a>
        <a href="/pages/cgv">CGV</a>
        <a href="/pages/mentions-legales">Mentions légales</a>
        <a href="/pages/politique-de-confidentialite">Confidentialité</a>
        <button type="button" id="si-footer-cookie-settings" class="si-footer-cookie-settings">Gérer les cookies</button>
        <a href="/pages/outils" class="si-footer-link">Outils gratuits</a>
        <a href="/pages/contact">Contact</a>
        <a href="/a-propos">À propos</a>
        <a href="/methodologie">Méthodologie</a>
      </div>
    </div>

    <div style="margin-top:1.25rem; padding-top:1rem; border-top:1px solid rgba(0,0,0,0.04);">
      <div class="si-footer-inner">
        <div class="si-footer-links si-footer-links--compact" style="justify-content:flex-start;">
          <a href="/barometre">Le Baromètre</a>
          <a href="/blogs/guides">Guides</a>
          <a href="/blogs/villes">Villes</a>
          <a href="/blogs/quartiers">Quartiers</a>
          <a href="/blogs/pro">Mandataires</a>
          <a href="/pages/auteurs">Méthode éditoriale</a>
          <a href="/pro">Score-Immo Pro</a>
          <a href="https://app.score-immo.fr/app?utm_source=site&utm_medium=footer">Accéder à l'outil &rarr;</a>
        </div>
        <div class="si-footer-links si-footer-links--compact" style="justify-content:flex-end;">
          <a href="tel:+33769812190">07 69 81 21 90</a>
          <a href="mailto:contact@score-immo.fr">contact@score-immo.fr</a>
        </div>
      </div>
      <nav class="si-footer-socials" aria-label="Réseaux sociaux Score-Immo">
        <span class="si-footer-socials-label">Suivre Score-Immo</span>
        <div class="si-footer-links si-footer-links--compact">
          {SOCIAL_PROFILES.map((profile) => (
            <a href={profile.url} target="_blank" rel="me noopener noreferrer">{profile.name}</a>
          ))}
        </div>
      </nav>
    </div>
  </div>
</footer>

<style>
  .si-footer-cookie-settings {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
  }
</style>

<script is:inline>
  document.getElementById('si-footer-cookie-settings')?.addEventListener('click', function () {
    window.siOpenCookieBanner?.();
  });
</script>
