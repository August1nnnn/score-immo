---
import { IOS_APP_URL } from '@/data/ios-app';
---
<aside id="ios-download-prompt" class="si-ios-prompt" aria-labelledby="si-ios-prompt-title" hidden>
  <div class="si-ios-prompt-copy">
    <p id="si-ios-prompt-title">Score‑Immo sur iOS</p>
    <a href={IOS_APP_URL} class="si-ios-prompt-link">Télécharger sur l’App Store <span aria-hidden="true">↗</span></a>
  </div>
  <button type="button" class="si-ios-prompt-close" data-ios-dismiss aria-label="Fermer la suggestion de téléchargement iOS">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" /></svg>
  </button>
</aside>

<style>
  .si-ios-prompt {
    position: fixed;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    right: max(0.75rem, env(safe-area-inset-right));
    left: max(0.75rem, env(safe-area-inset-left));
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    max-width: 360px;
    margin-inline: auto;
    padding: 0.75rem 0.5rem 0.5rem 1rem;
    box-sizing: border-box;
    border: 1px solid #cbd5e1;
    border-radius: 1rem;
    background: #fff;
    color: #0f172a;
    box-shadow: 0 8px 30px rgb(15 23 42 / 16%);
  }
  .si-ios-prompt[hidden] { display: none; }
  .si-ios-prompt-copy { min-width: 0; }
  .si-ios-prompt-copy p { margin: 0; font-size: 0.875rem; font-weight: 700; }
  .si-ios-prompt-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    color: #1d4ed8;
    font-size: 0.8125rem;
    line-height: 1.4;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .si-ios-prompt-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 0.5rem;
    background: #f1f5f9;
    color: #475569;
    cursor: pointer;
  }
  .si-ios-prompt :focus-visible { outline: 3px solid #2563eb; outline-offset: 3px; }
</style>

<script>
  import { initIOSDownloadPrompt } from '@/lib/ios-download-prompt.mjs';
  initIOSDownloadPrompt();
</script>
